{% liquid
  assign left_collection = section.settings.left_collection | default: collections['moss']
  assign right_collection = section.settings.right_collection | default: collections['cove']

  assign left_title = left_collection.title | default: 'Moss'
  assign right_title = right_collection.title | default: 'Cove'
  assign left_title = left_title | replace: ' Collection', '' | replace: ' collection', ''
  assign right_title = right_title | replace: ' Collection', '' | replace: ' collection', ''

  assign left_url = left_collection.url | default: routes.all_products_collection_url
  assign right_url = right_collection.url | default: routes.all_products_collection_url

  assign left_image = section.settings.left_image
  if left_image == blank and left_collection != blank
    assign left_image = left_collection.featured_image
  endif

  assign right_image = section.settings.right_image
  if right_image == blank and right_collection != blank
    assign right_image = right_collection.featured_image
  endif
%}

{% render 'swimdays-home-fonts' %}

<section
  id="silhouettes"
  class="swimdays-home-collections silhouettes-wrapper"
  data-swimdays-home-collections
  data-section-id="{{ section.id }}"
>
  <div class="sil-main">
    <a href="{{ left_url }}" class="sil-side sil-side--left">
      <div class="sil-side-media" aria-hidden="true">
        {% if left_image != blank %}
          {{
            left_image
            | image_url: width: 2000
            | image_tag:
              class: 'sil-side-image',
              alt: '',
              widths: '640, 900, 1200, 1600, 2000',
              sizes: '(max-width: 768px) 100vw, 50vw',
              loading: 'lazy'
          }}
        {% endif %}
      </div>
      <div class="sil-side-heading">
        <span class="sil-collection-title">
          <span class="sil-collection-word">The</span>
          <span class="sil-collection-accent">{{ left_title }}</span>
          <span class="sil-collection-word">Collection</span>
        </span>
        <span class="sil-shop-now">{{ section.settings.shop_now_label }}</span>
      </div>
    </a>

    <a href="{{ right_url }}" class="sil-side sil-side--right">
      <div class="sil-side-media" aria-hidden="true">
        {% if right_image != blank %}
          {{
            right_image
            | image_url: width: 2000
            | image_tag:
              class: 'sil-side-image',
              alt: '',
              widths: '640, 900, 1200, 1600, 2000',
              sizes: '(max-width: 768px) 100vw, 50vw',
              loading: 'lazy'
          }}
        {% endif %}
      </div>
      <div class="sil-side-heading">
        <span class="sil-collection-title">
          <span class="sil-collection-word">The</span>
          <span class="sil-collection-accent">{{ right_title }}</span>
          <span class="sil-collection-word">Collection</span>
        </span>
        <span class="sil-shop-now">{{ section.settings.shop_now_label }}</span>
      </div>
    </a>
  </div>
</section>

{% stylesheet %}
  .swimdays-home-collections {
    background: #f7f6f2;
    margin: 0;
    overflow: hidden;
    width: 100%;
  }

  .swimdays-home-collections .sil-main {
    display: flex;
    height: 100svh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .swimdays-home-collections .sil-side {
    display: block;
    height: 100%;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    width: 50%;
    z-index: 2;
  }

  .swimdays-home-collections .sil-side-media {
    inset: 0;
    position: absolute;
    z-index: -1;
  }

  .swimdays-home-collections .sil-side::before {
    background:
      linear-gradient(180deg, rgba(247, 246, 242, 0.06), rgba(247, 246, 242, 0.02));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .swimdays-home-collections .sil-side-image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    width: 100%;
  }

  .swimdays-home-collections .sil-side:hover .sil-side-image {
    transform: scale(1.025);
  }

  .swimdays-home-collections .sil-side--left .sil-side-image {
    object-position: center 40%;
  }

  .swimdays-home-collections .sil-side--right .sil-side-image {
    object-position: center 55%;
  }

  .swimdays-home-collections .sil-side-heading {
    align-items: baseline;
    color: #34565b;
    display: flex;
    font-size: var(--text-base, 1rem);
    gap: 1rem;
    justify-content: space-between;
    letter-spacing: 0;
    margin-top: clamp(60px, 7vw, 72px);
    padding: 0 clamp(1.5rem, 3vw, 2.5rem);
    position: relative;
    text-shadow: none;
    z-index: 2;
  }

  .swimdays-home-collections .sil-collection-title {
    align-items: baseline;
    display: inline-flex;
    gap: 0.28rem;
    line-height: 1.1;
  }

  .swimdays-home-collections .sil-collection-word {
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.08rem, 0.98rem + 0.26vw, 1.26rem);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .swimdays-home-collections .sil-collection-accent {
    font-family: "Swimdays Accent", cursive;
    font-size: clamp(1.52rem, 1.34rem + 0.52vw, 2.02rem);
    letter-spacing: 0;
    line-height: 0.92;
    text-transform: none;
    transform: translateY(0.08em);
  }

  .swimdays-home-collections .sil-shop-now {
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: clamp(0.8rem, 0.74rem + 0.16vw, 0.92rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media screen and (max-width: 1024px) {
    .swimdays-home-collections .sil-side-heading {
      padding-inline: clamp(1.15rem, 2.4vw, 1.8rem);
    }

    .swimdays-home-collections .sil-collection-word {
      font-size: clamp(1rem, 0.88rem + 0.28vw, 1.14rem);
    }

    .swimdays-home-collections .sil-collection-accent {
      font-size: clamp(1.34rem, 1.12rem + 0.62vw, 1.72rem);
    }

    .swimdays-home-collections .sil-shop-now {
      font-size: clamp(0.72rem, 0.66rem + 0.16vw, 0.82rem);
    }
  }

  @media screen and (max-width: 768px) {
    .swimdays-home-collections .sil-main {
      flex-direction: column;
      height: auto;
      min-height: auto;
    }

    .swimdays-home-collections .sil-side {
      height: auto;
      min-height: clamp(20rem, 58svh, 28rem);
      width: 100%;
    }

    .swimdays-home-collections .sil-side-heading {
      align-items: center;
      height: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0;
      padding-block: clamp(1rem, 4.8vw, 1.45rem);
      padding-inline: clamp(1rem, 4.8vw, 1.35rem);
    }

    .swimdays-home-collections .sil-collection-title {
      flex-wrap: wrap;
      gap: 0.22rem;
      max-width: 12ch;
    }

    .swimdays-home-collections .sil-collection-word {
      font-size: clamp(0.9rem, 0.78rem + 0.7vw, 1rem);
    }

    .swimdays-home-collections .sil-collection-accent {
      font-size: clamp(1.16rem, 1rem + 1.3vw, 1.42rem);
    }

    .swimdays-home-collections .sil-shop-now {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }

  @media screen and (max-width: 479px) {
    .swimdays-home-collections .sil-side {
      min-height: clamp(18rem, 54svh, 24rem);
    }

    .swimdays-home-collections .sil-side-heading {
      gap: 0.65rem;
    }

    .swimdays-home-collections .sil-collection-title {
      max-width: 10.5ch;
    }

    .swimdays-home-collections .sil-shop-now {
      font-size: 0.68rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const loaderKey = '__swimdaysHomeCollectionsGsapLoader';

    const loadScript = (src) =>
      new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[data-swimdays-src="${src}"]`);

        if (existing) {
          if (existing.dataset.loaded === 'true') {
            resolve();
            return;
          }

          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.dataset.swimdaysSrc = src;
        script.addEventListener('load', () => {
          script.dataset.loaded = 'true';
          resolve();
        }, { once: true });
        script.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
        document.head.appendChild(script);
      });

    const ensureGsap = async () => {
      if (window.gsap && window.ScrollTrigger) return;

      if (!window[loaderKey]) {
        window[loaderKey] = (async () => {
          await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js');
          await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js');
        })();
      }

      await window[loaderKey];
    };

    const initCollections = async (root = document) => {
      const sections = root.querySelectorAll('[data-swimdays-home-collections]');
      if (!sections.length) return;

      await ensureGsap();
      if (!(window.gsap && window.ScrollTrigger)) return;

      const { gsap, ScrollTrigger } = window;
      gsap.registerPlugin(ScrollTrigger);

      sections.forEach((section) => {
        if (section.dataset.swimdaysCollectionsInit === 'true') return;
        section.dataset.swimdaysCollectionsInit = 'true';

        const media = gsap.matchMedia();
        section._swimdaysCollectionsMedia = media;

        media.add('(min-width: 769px)', () => {
          const headings = section.querySelectorAll('.sil-side-heading');
          const triggers = [];

          headings.forEach((heading) => {
            const container = heading.closest('.sil-side');
            if (!container) return;

            const maxTravel = Math.max(0, container.offsetHeight - (heading.offsetTop * 2) - heading.offsetHeight);

            const timeline = gsap.timeline({
              scrollTrigger: {
                trigger: heading,
                start: 'top 45%',
                end: () => `+=${maxTravel}`,
                scrub: true
              }
            });

            timeline.to(heading, {
              y: maxTravel,
              ease: 'none',
              duration: 1
            }, 0);

            timeline.to(heading, {
              color: '#ffffff',
              ease: 'none',
              duration: 0.5
            }, 0.5);

            triggers.push(timeline);
          });

          return () => {
            triggers.forEach((timeline) => timeline.kill());
          };
        });

        media.add('(max-width: 768px)', () => {
          gsap.set(section.querySelectorAll('.sil-side-heading'), { clearProps: 'transform' });
        });
      });
    };

    const destroyCollections = (section) => {
      if (section && section._swimdaysCollectionsMedia) {
        section._swimdaysCollectionsMedia.revert();
        delete section._swimdaysCollectionsMedia;
      }

      if (section) {
        delete section.dataset.swimdaysCollectionsInit;
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initCollections());
    } else {
      initCollections();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initCollections(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      destroyCollections(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Swimdays collections",
  "tag": "section",
  "class": "shopify-section--swimdays-home-collections",
  "limit": 1,
  "settings": [
    {
      "type": "collection",
      "id": "left_collection",
      "label": "Left collection"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image override"
    },
    {
      "type": "collection",
      "id": "right_collection",
      "label": "Right collection"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image override"
    },
    {
      "type": "text",
      "id": "shop_now_label",
      "label": "Shop now label",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Swimdays collections"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
