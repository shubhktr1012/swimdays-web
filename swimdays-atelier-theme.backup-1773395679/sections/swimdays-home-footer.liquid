{% liquid
  assign logo_image = section.settings.logo
  if logo_image == blank
    assign logo_image = settings.logo
  endif

  assign shop_menu = section.settings.shop_menu
  assign support_menu = section.settings.support_menu
  assign brand_menu = section.settings.brand_menu
%}

<section class="swimdays-home-footer-section" data-testid="swimdays-home-footer">
  <footer class="swimdays-home-footer">
    <div class="swimdays-home-footer__decor" aria-hidden="true">
      <img src="{{ 'flower.svg' | asset_url }}" alt="" class="swimdays-home-footer__flower swimdays-home-footer__flower--bottom-right" width="64" height="64">
      <img src="{{ 'flower.svg' | asset_url }}" alt="" class="swimdays-home-footer__flower swimdays-home-footer__flower--bottom-left" width="64" height="64">
    </div>

    <div class="swimdays-home-footer__inner">
      <div class="swimdays-home-footer__newsletter">
        <p class="swimdays-home-footer__newsletter-copy">
          {{ section.settings.newsletter_copy }}
        </p>

        {% form 'customer', class: 'swimdays-home-footer__form', id: 'ContactFooter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="swimdays-home-footer__input-group">
            <input
              type="email"
              name="contact[email]"
              class="swimdays-home-footer__input"
              placeholder="Your email address"
              required
              aria-label="Email address"
              autocomplete="email"
            >
            <button type="submit" class="swimdays-home-footer__button" name="commit">Sign up</button>
          </div>

          <p class="swimdays-home-footer__privacy">
            By signing up you are agreeing to our Privacy Policy.
          </p>
        {% endform %}
      </div>

      <div class="swimdays-home-footer__brand">
        <a href="{{ routes.root_url }}" class="swimdays-home-footer__logo-link" aria-label="{{ shop.name }}">
          {% if logo_image != blank %}
            {{ logo_image | image_url: width: 320 | image_tag: class: 'swimdays-home-footer__logo', alt: shop.name }}
          {% else %}
            <span class="swimdays-home-footer__wordmark">{{ shop.name }}</span>
          {% endif %}
        </a>

        <div class="swimdays-home-footer__menus">
          <div class="swimdays-home-footer__menu-column">
            <h3 class="swimdays-home-footer__heading">Shop</h3>
            {% if shop_menu != blank %}
              <ul class="swimdays-home-footer__menu">
                {% for link in shop_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <div class="swimdays-home-footer__menu-column">
            <h3 class="swimdays-home-footer__heading">Support</h3>
            {% if support_menu != blank %}
              <ul class="swimdays-home-footer__menu">
                {% for link in support_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>

          <div class="swimdays-home-footer__menu-column">
            <h3 class="swimdays-home-footer__heading">Swimdays</h3>
            {% if brand_menu != blank %}
              <ul class="swimdays-home-footer__menu">
                {% for link in brand_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="swimdays-home-footer__bottom">
        <div class="swimdays-home-footer__socials">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}">Instagram</a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}">Facebook</a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}">YouTube</a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}">TikTok</a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}">Pinterest</a>
          {% endif %}
        </div>

        <div class="swimdays-home-footer__meta">
          {% if section.settings.contact_email != blank %}
            <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
          {% endif %}
          <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.</p>
        </div>
      </div>
    </div>
  </footer>
</section>

{% stylesheet %}
  .swimdays-home-footer-section {
    --swimdays-footer-bg: var(--color-background, #f7f6f2);
    --swimdays-footer-ink: #34565b;
    --swimdays-footer-rose: #a84f77;
    --swimdays-footer-rose-soft: rgba(168, 79, 119, 0.72);
    --swimdays-footer-line: rgba(168, 79, 119, 0.5);
    --swimdays-footer-gutter: clamp(0.85rem, 2.1vw, 4.5rem);
    --swimdays-footer-container: calc(100% - (var(--swimdays-footer-gutter) * 2));
    background: var(--swimdays-footer-bg);
    color: var(--swimdays-footer-ink);
  }

  .swimdays-home-footer {
    border-top: 1px solid var(--swimdays-footer-line);
    color: var(--swimdays-footer-ink);
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
    overflow: hidden;
    padding: clamp(3rem, 5vw, 6rem) 0 clamp(2rem, 3vw, 4rem);
    position: relative;
    width: 100%;
  }

  .swimdays-home-footer__decor {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }

  .swimdays-home-footer__flower {
    filter: brightness(0) saturate(100%) invert(42%) sepia(21%) saturate(1514%) hue-rotate(294deg) brightness(86%) contrast(85%);
    height: 64px;
    opacity: 1;
    position: absolute;
    width: 64px;
  }

  .swimdays-home-footer__flower--bottom-right {
    bottom: -18px;
    right: -18px;
  }

  .swimdays-home-footer__flower--bottom-left {
    bottom: -18px;
    left: -18px;
  }

  .swimdays-home-footer__inner {
    display: grid;
    gap: 2.5rem;
    grid-template-areas:
      'newsletter'
      'brand'
      'bottom';
    margin: 0 auto;
    position: relative;
    width: var(--swimdays-footer-container);
    z-index: 1;
  }

  .swimdays-home-footer__newsletter {
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0;
    grid-area: newsletter;
    margin: calc(clamp(3rem, 5vw, 6rem) * -1) calc(var(--swimdays-footer-gutter) * -1) 0;
    padding: clamp(3rem, 5vw, 6rem) var(--swimdays-footer-gutter) 2rem;
    position: relative;
  }

  .swimdays-home-footer__newsletter::before {
    background: var(--swimdays-footer-rose);
    content: '';
    inset: 0;
    position: absolute;
    z-index: -1;
  }

  .swimdays-home-footer__newsletter-copy {
    color: #fff;
    line-height: 1.6;
    margin: 0 0 0.85rem;
    max-width: none;
  }

  .swimdays-home-footer__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .swimdays-home-footer__input-group {
    align-items: end;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    display: grid;
    gap: 0.875rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-bottom: 0.25rem;
    transition: border-color 0.3s ease;
  }

  .swimdays-home-footer__input {
    -webkit-appearance: none;
    appearance: none;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    caret-color: #fff;
    color: #fff;
    font: inherit;
    line-height: 1.2;
    margin: 0;
    min-height: 0;
    outline: none;
    padding: 0;
    width: 100%;
  }

  .swimdays-home-footer__input::placeholder {
    color: rgba(255, 255, 255, 0.8);
    opacity: 1;
  }

  .swimdays-home-footer__input-group:focus-within {
    border-bottom-color: #fff;
  }

  .swimdays-home-footer__input:focus {
    outline: none;
  }

  .swimdays-home-footer__input:is(:hover, :focus, :active) {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
  }

  .swimdays-home-footer__input:-webkit-autofill,
  .swimdays-home-footer__input:-webkit-autofill:hover,
  .swimdays-home-footer__input:-webkit-autofill:focus {
    -webkit-text-fill-color: #fff;
    box-shadow: 0 0 0 1000px transparent inset !important;
    caret-color: #fff;
    transition: background-color 9999s ease-out 0s;
  }

  .swimdays-home-footer__button {
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0 0 0.35rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .swimdays-home-footer__privacy {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.75rem;
    margin: 0.25rem 0 0;
  }

  .swimdays-home-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    grid-area: brand;
  }

  .swimdays-home-footer__logo-link {
    display: block;
    max-width: 180px;
    text-decoration: none;
    width: 100%;
  }

  .swimdays-home-footer__logo {
    filter: brightness(0) saturate(100%) invert(26%) sepia(15%) saturate(1094%) hue-rotate(138deg) brightness(95%) contrast(87%);
    height: auto;
    object-fit: contain;
    width: 100%;
  }

  .swimdays-home-footer__wordmark {
    color: var(--swimdays-footer-ink);
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: 1.5rem;
  }

  .swimdays-home-footer__menus {
    display: grid;
    gap: 1.5rem 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .swimdays-home-footer__menu-column:last-child {
    grid-column: 1 / -1;
  }

  .swimdays-home-footer__heading {
    color: rgba(52, 86, 91, 0.68);
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
  }

  .swimdays-home-footer__menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .swimdays-home-footer__menu a,
  .swimdays-home-footer__socials a,
  .swimdays-home-footer__meta a {
    color: var(--swimdays-footer-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .swimdays-home-footer__menu a:hover,
  .swimdays-home-footer__socials a:hover,
  .swimdays-home-footer__meta a:hover {
    color: var(--swimdays-footer-rose);
  }

  .swimdays-home-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    grid-area: bottom;
  }

  .swimdays-home-footer__socials {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.25rem;
  }

  .swimdays-home-footer__socials a {
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .swimdays-home-footer__meta {
    color: rgba(52, 86, 91, 0.68);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .swimdays-home-footer__meta p {
    margin: 0;
  }

  @media screen and (max-width: 639px) {
    .swimdays-home-footer__menus {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .swimdays-home-footer__menu-column:last-child {
      grid-column: auto;
    }
  }

  @media screen and (min-width: 960px) {
    .swimdays-home-footer__inner {
      gap: 2.5rem 6rem;
      grid-template-areas:
        'brand newsletter'
        'brand bottom';
      grid-template-columns: 1fr 1.2fr;
      grid-template-rows: auto 1fr;
    }

    .swimdays-home-footer__brand {
      gap: 4rem;
      justify-content: space-between;
    }

    .swimdays-home-footer__logo-link {
      max-width: 240px;
    }

    .swimdays-home-footer__menus {
      gap: 2rem;
      grid-template-columns: repeat(3, minmax(auto, 1fr));
    }

    .swimdays-home-footer__menu-column:last-child {
      grid-column: auto;
    }

    .swimdays-home-footer__newsletter {
      color: #fff;
      margin: 0;
      overflow: visible;
      padding: 2rem 2.25rem;
      z-index: 0;
    }

    .swimdays-home-footer__newsletter::before {
      inset: 0 calc(var(--swimdays-footer-gutter) * -1) 0 0;
    }

    .swimdays-home-footer__newsletter-copy {
      margin-bottom: 0.85rem;
      max-width: 50ch;
    }

    .swimdays-home-footer__form {
      margin-bottom: 1.25rem;
    }

    .swimdays-home-footer__bottom {
      margin-top: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swimdays home footer",
  "tag": "section",
  "class": "shopify-section--swimdays-home-footer",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "newsletter_copy",
      "label": "Newsletter copy",
      "default": "We believe in simplicity. One beautifully curated email each month with product news, tips, and tailored recommendations. Nothing more. Just the good stuff."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "studioswimdays@gmail.com"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support menu"
    },
    {
      "type": "link_list",
      "id": "brand_menu",
      "label": "Brand menu"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ],
  "presets": [
    {
      "name": "Swimdays home footer"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
