{% liquid
  assign byline_metafield = article.metafields.custom.byline
  assign custom_byline = byline_metafield.value | default: byline_metafield | default: article.author | default: 'Team Swimdays'
  assign custom_byline = custom_byline | strip
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      blog-post-shell
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <header class="blog-post-header">
      {%- content_for 'block', id: 'blog-post-title', type: 'text' %}
      {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}

      {% if custom_byline != blank %}
        <p class="blog-post-byline">{{ custom_byline }}</p>
      {% endif %}
    </header>

    {%- if article.image -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}
    {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}

    {% liquid
      assign cta_primary_url = section.settings.cta_primary_link | default: collections['moss'].url
      assign cta_secondary_url = section.settings.cta_secondary_link | default: collections['cove'].url
    %}

    {% if section.settings.show_soft_cta %}
      <aside class="blog-post-soft-cta">
        {% if section.settings.cta_heading != blank %}
          <h2 class="blog-post-soft-cta__heading">{{ section.settings.cta_heading }}</h2>
        {% endif %}

        {% if section.settings.cta_body != blank %}
          <p class="blog-post-soft-cta__body">{{ section.settings.cta_body }}</p>
        {% endif %}

        <div class="blog-post-soft-cta__actions">
          {% if section.settings.cta_primary_label != blank %}
            <a href="{{ cta_primary_url }}" class="blog-post-soft-cta__button blog-post-soft-cta__button--primary">
              {{ section.settings.cta_primary_label }}
            </a>
          {% endif %}

          {% if section.settings.cta_secondary_label != blank %}
            <a href="{{ cta_secondary_url }}" class="blog-post-soft-cta__button blog-post-soft-cta__button--secondary">
              {{ section.settings.cta_secondary_label }}
            </a>
          {% endif %}
        </div>
      </aside>
    {% endif %}

    {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

{% render 'swimdays-structured-data-article', article: article, author_name: custom_byline %}

{% stylesheet %}
  .section-wrapper:has(.blog-post-shell) {
    background: #faf6f1;
  }

  .blog-post-shell {
    --swimdays-article-ocean: #34565b;
    --swimdays-article-rose: #a84f77;
    --swimdays-article-cream: #faf6f1;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .blog-post-shell > .blog-post-header {
    width: 100%;
    max-width: min(42rem, calc(100vw - 2rem));
    margin: 0 auto;
    text-align: center;
  }

  .blog-post-shell > .blog-post-header :is(h1, .h1, .h2, .text-block) {
    color: var(--swimdays-article-ocean);
    font-family: "Swimdays Heading", Aboreto, Georgia, serif;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .blog-post-shell > .blog-post-header .blog-post-info-text,
  .blog-post-shell > .blog-post-header [class*='blog-post-info'] {
    color: var(--swimdays-article-rose);
    font-family: "Swimdays Subhead", "Public Sans", sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-post-byline {
    margin: 0.75rem 0 0;
    font-family: "Swimdays Body", "Public Sans", sans-serif;
    font-size: 0.98rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--swimdays-article-ocean) 78%, #000);
  }

  .blog-post-shell > .blog-post-featured-image {
    width: 100%;
    max-width: min(48rem, calc(100vw - 2rem));
    margin: 0 auto;
  }

  .blog-post-shell > .blog-post-featured-image .blog-post-featured-image__image,
  .blog-post-shell > .blog-post-featured-image .border-style {
    border: 0 !important;
    border-radius: 0;
    box-shadow: none;
  }

  .blog-post-shell > .blog-post-content {
    width: 100%;
  }

  .blog-post-soft-cta {
    width: 100%;
    max-width: min(42rem, calc(100vw - 2rem));
    margin: clamp(1.75rem, 3.5vw, 2.75rem) auto 0;
    padding: clamp(1.75rem, 3.2vw, 2.6rem);
    border: 1px solid color-mix(in srgb, var(--swimdays-article-rose) 28%, transparent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--swimdays-article-rose) 10%, var(--swimdays-article-cream)),
        var(--swimdays-article-cream)
      );
    text-align: center;
  }

  .blog-post-soft-cta__heading {
    margin: 0 0 0.75rem;
    color: var(--swimdays-article-ocean);
    font-family: "Swimdays Heading", Aboreto, Georgia, serif;
    font-weight: 400;
  }

  .blog-post-soft-cta__body {
    margin: 0 auto 1.5rem;
    max-width: 34rem;
    font-family: "Swimdays Body", "Public Sans", sans-serif;
    line-height: 1.7;
    color: color-mix(in srgb, var(--swimdays-article-ocean) 80%, #000);
  }

  .blog-post-soft-cta__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .blog-post-soft-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9.5rem;
    padding: 0.9rem 1.35rem;
    font-family: "Swimdays Subhead", "Public Sans", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .blog-post-soft-cta__button--primary {
    background: #34565b;
    color: #faf6f1;
  }

  .blog-post-soft-cta__button--primary:hover {
    background: #284449;
    color: #faf6f1;
  }

  .blog-post-soft-cta__button--secondary {
    border: 1px solid color-mix(in srgb, var(--swimdays-article-ocean) 35%, transparent);
    color: var(--swimdays-article-ocean);
  }

  .blog-post-soft-cta__button--secondary:hover {
    border-color: #a84f77;
    color: #a84f77;
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Bottom call to action"
    },
    {
      "type": "checkbox",
      "id": "show_soft_cta",
      "label": "Show soft CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Explore the collections"
    },
    {
      "type": "textarea",
      "id": "cta_body",
      "label": "CTA body",
      "default": "Discover the silhouettes, colours, and details that inspired this story."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop Moss"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Shop Cove"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary CTA link"
    }
  ],
  "presets": []
}
{% endschema %}
