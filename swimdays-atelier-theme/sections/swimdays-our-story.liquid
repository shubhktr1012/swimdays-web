{% liquid
  assign hero_eyebrow = section.settings.hero_eyebrow | default: 'OUR STORY'
  assign hero_title = section.settings.hero_title | default: 'Inspired from Sundays'
  assign hero_intro = section.settings.hero_intro | default: 'For two sisters in India, summer Sundays once meant early-morning pool sessions, hearty breakfasts, and a search for swimwear that never felt quite right.'
  assign story_label = section.settings.story_label | default: 'The Beginning'
  assign story_paragraph_1 = section.settings.story_paragraph_1
  assign story_paragraph_2 = section.settings.story_paragraph_2
  assign story_paragraph_3 = section.settings.story_paragraph_3
  assign story_paragraph_4 = section.settings.story_paragraph_4
  assign brand_essence = section.settings.brand_essence
  assign goal_title = section.settings.goal_title | default: 'OUR GOAL'
  assign goal_body = section.settings.goal_body
  assign founders_title = section.settings.founders_title | default: "FOUNDERS' NOTE"
  assign founder_1_name = section.settings.founder_1_name | default: 'Zahabiya'
  assign founder_2_name = section.settings.founder_2_name | default: 'Fatema'
  assign founder_1_quote = section.settings.founder_1_quote
  assign founder_2_quote = section.settings.founder_2_quote
  assign cta_title = section.settings.cta_title | default: 'Explore the collections'
  assign cta_body = section.settings.cta_body
  assign portrait_alt = section.settings.founders_portrait_alt | default: 'Portrait of the Swimdays founders'
  assign cta_primary_link = section.settings.cta_primary_link
  assign cta_secondary_link = section.settings.cta_secondary_link

  if cta_primary_link == blank and collections['moss'] != blank
    assign cta_primary_link = collections['moss'].url
  endif
  if cta_primary_link == blank
    assign cta_primary_link = routes.all_products_collection_url
  endif

  if cta_secondary_link == blank and collections['cove'] != blank
    assign cta_secondary_link = collections['cove'].url
  endif
  if cta_secondary_link == blank
    assign cta_secondary_link = routes.all_products_collection_url
  endif
%}

{% render 'swimdays-home-fonts' %}

<section class="swimdays-our-story" data-swimdays-our-story>
  <div class="swimdays-our-story__shell">
    <div class="swimdays-our-story__hero">
      <figure class="swimdays-our-story__hero-media">
        {% if section.settings.founders_portrait != blank %}
          {{
            section.settings.founders_portrait
            | image_url: width: 1600
            | image_tag:
              class: 'swimdays-our-story__hero-image',
              alt: portrait_alt,
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(max-width: 959px) calc(100vw - 2rem), (max-width: 1439px) 42vw, 520px',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {% else %}
          <div class="swimdays-our-story__hero-placeholder" aria-hidden="true">
            <span>{{ 'Founders portrait' | escape }}</span>
          </div>
        {% endif %}
      </figure>

      <div class="swimdays-our-story__hero-copy">
        <p class="swimdays-our-story__eyebrow">{{ hero_eyebrow | escape }}</p>
        <h1 class="swimdays-our-story__title">{{ hero_title | escape }}</h1>
        <div class="swimdays-our-story__intro">
          <p>{{ hero_intro | escape }}</p>
        </div>

        <div class="swimdays-our-story__divider" aria-hidden="true">
          <span class="swimdays-our-story__divider-line"></span>
          <img
            src="{{ 'flower.svg' | asset_url }}"
            alt=""
            class="swimdays-our-story__divider-flower"
            width="22"
            height="22"
            loading="lazy"
          >
          <span class="swimdays-our-story__divider-line"></span>
        </div>
      </div>
    </div>

    <div class="swimdays-our-story__body">
      <div class="swimdays-our-story__story">
        <div class="swimdays-our-story__section-meta">{{ story_label | escape }}</div>
        <div class="swimdays-our-story__prose">
          {% if story_paragraph_1 != blank %}
            <p>{{ story_paragraph_1 | escape }}</p>
          {% endif %}
          {% if story_paragraph_2 != blank %}
            <p>{{ story_paragraph_2 | escape }}</p>
          {% endif %}
          {% if story_paragraph_3 != blank %}
            <p>{{ story_paragraph_3 | escape }}</p>
          {% endif %}
          {% if story_paragraph_4 != blank %}
            <p>{{ story_paragraph_4 | escape }}</p>
          {% endif %}
        </div>
      </div>

      {% if brand_essence != blank %}
        <div class="swimdays-our-story__essence">
          <p>{{ brand_essence | escape }}</p>
        </div>
      {% endif %}

      {% if goal_body != blank %}
        <div class="swimdays-our-story__goal">
          <h2 class="swimdays-our-story__section-heading">{{ goal_title | escape }}</h2>
          <div class="swimdays-our-story__goal-copy">
            <p>{{ goal_body | escape }}</p>
          </div>
        </div>
      {% endif %}

      <div class="swimdays-our-story__notes">
        <h2 class="swimdays-our-story__section-heading">{{ founders_title | escape }}</h2>

        <div class="swimdays-our-story__notes-grid">
          {% if founder_1_quote != blank %}
            <article class="swimdays-our-story__note-card">
              <p class="swimdays-our-story__note-name">{{ founder_1_name | escape }}</p>
              <blockquote class="swimdays-our-story__note-quote">
                <p>{{ founder_1_quote | escape }}</p>
              </blockquote>
            </article>
          {% endif %}

          {% if founder_2_quote != blank %}
            <article class="swimdays-our-story__note-card">
              <p class="swimdays-our-story__note-name">{{ founder_2_name | escape }}</p>
              <blockquote class="swimdays-our-story__note-quote">
                <p>{{ founder_2_quote | escape }}</p>
              </blockquote>
            </article>
          {% endif %}
        </div>
      </div>

      <div class="swimdays-our-story__cta">
        <h2 class="swimdays-our-story__section-heading">{{ cta_title | escape }}</h2>

        {% if cta_body != blank %}
          <div class="swimdays-our-story__cta-copy">
            <p>{{ cta_body | escape }}</p>
          </div>
        {% endif %}

        <div class="swimdays-our-story__cta-actions">
          <a href="{{ cta_primary_link }}" class="swimdays-our-story__cta-button swimdays-our-story__cta-button--primary">
            {{ section.settings.cta_primary_label | default: 'Shop Moss' | escape }}
          </a>
          <a href="{{ cta_secondary_link }}" class="swimdays-our-story__cta-button swimdays-our-story__cta-button--secondary">
            {{ section.settings.cta_secondary_label | default: 'Shop Cove' | escape }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .swimdays-our-story {
    --story-bg: #f7f6f2;
    --story-surface: #fcfaf6;
    --story-copy: #4b463f;
    --story-heading: #2e2b26;
    --story-accent: #a84f77;
    --story-accent-soft: rgba(168, 79, 119, 0.08);
    --story-line: rgba(46, 43, 38, 0.14);
    background:
      radial-gradient(circle at top left, rgba(52, 86, 91, 0.08), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0)),
      var(--story-bg);
    color: var(--story-copy);
    overflow: clip;
    padding: clamp(2.5rem, 4vw, 4rem) clamp(1rem, 4vw, 2rem) clamp(4rem, 7vw, 6rem);
  }

  .swimdays-our-story__shell {
    margin: 0 auto;
    width: min(100%, 1320px);
  }

  .swimdays-our-story__hero,
  .swimdays-our-story__story,
  .swimdays-our-story__goal,
  .swimdays-our-story__notes,
  .swimdays-our-story__cta {
    container-type: inline-size;
  }

  .swimdays-our-story__hero {
    align-items: start;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    grid-template-columns: minmax(0, 1fr);
  }

  .swimdays-our-story__hero-media {
    border: 1px solid rgba(46, 43, 38, 0.08);
    margin: 0;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  .swimdays-our-story__hero-media::after {
    border: 1px solid rgba(255, 255, 255, 0.45);
    content: "";
    inset: 1rem;
    pointer-events: none;
    position: absolute;
  }

  .swimdays-our-story__hero-image,
  .swimdays-our-story__hero-placeholder {
    aspect-ratio: 4 / 5;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .swimdays-our-story__hero-placeholder {
    align-items: center;
    background:
      linear-gradient(160deg, rgba(52, 86, 91, 0.18), rgba(52, 86, 91, 0) 45%),
      linear-gradient(330deg, rgba(168, 79, 119, 0.12), rgba(168, 79, 119, 0) 50%),
      #ece6dd;
    color: rgba(46, 43, 38, 0.66);
    display: grid;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .swimdays-our-story__hero-copy {
    align-self: center;
    display: grid;
    gap: clamp(1rem, 2.2vw, 1.6rem);
    min-width: 0;
    padding-block: clamp(0.4rem, 1vw, 1rem);
  }

  .swimdays-our-story__eyebrow,
  .swimdays-our-story__section-meta,
  .swimdays-our-story__note-name {
    color: var(--story-accent);
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
  }

  .swimdays-our-story__title,
  .swimdays-our-story__section-heading {
    color: var(--story-heading);
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(2.3rem, 6vw, 4.9rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 0.95;
    margin: 0;
    max-width: 14ch;
    text-wrap: balance;
  }

  .swimdays-our-story__section-heading {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.02;
    max-width: none;
    text-align: center;
  }

  .swimdays-our-story__intro {
    max-width: 33rem;
  }

  .swimdays-our-story__intro p,
  .swimdays-our-story__prose p,
  .swimdays-our-story__goal-copy p,
  .swimdays-our-story__note-quote p,
  .swimdays-our-story__cta-copy p {
    color: var(--story-copy);
    font-family: "Swimdays Body", "Public Sans", sans-serif;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.8;
    margin: 0;
  }

  .swimdays-our-story__divider {
    align-items: center;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr auto 1fr;
    max-width: min(22rem, 100%);
    width: 100%;
  }

  .swimdays-our-story__divider-line {
    background: rgba(168, 79, 119, 0.56);
    display: block;
    height: 1px;
  }

  .swimdays-our-story__divider-flower {
    display: block;
    filter: brightness(0) saturate(100%) invert(42%) sepia(21%) saturate(1514%) hue-rotate(294deg) brightness(86%) contrast(85%);
    height: 22px;
    width: 22px;
  }

  .swimdays-our-story__body {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    margin-top: clamp(3rem, 8vw, 6.5rem);
  }

  .swimdays-our-story__story {
    display: grid;
    gap: 1rem;
    justify-content: center;
  }

  .swimdays-our-story__prose {
    display: grid;
    gap: clamp(1.2rem, 2vw, 1.7rem);
    margin-inline: auto;
    max-width: min(100%, 72ch);
    width: 100%;
  }

  .swimdays-our-story__essence {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.3)),
      var(--story-accent-soft);
    border-block: 1px solid rgba(168, 79, 119, 0.16);
    margin-inline: clamp(-1rem, -3vw, -2rem);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 5vw, 3rem);
  }

  .swimdays-our-story__essence p {
    color: #34565b;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.28rem, 1rem + 1vw, 2rem);
    line-height: 1.45;
    margin: 0 auto;
    max-width: min(100%, 34ch);
    text-align: center;
    text-wrap: balance;
  }

  .swimdays-our-story__goal {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .swimdays-our-story__goal-copy {
    max-width: min(100%, 58ch);
    text-align: center;
  }

  .swimdays-our-story__notes {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2rem);
  }

  .swimdays-our-story__notes-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .swimdays-our-story__note-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.55));
    border: 1px solid rgba(46, 43, 38, 0.08);
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    position: relative;
  }

  .swimdays-our-story__note-card::before {
    color: rgba(168, 79, 119, 0.16);
    content: "“";
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(4rem, 8vw, 6rem);
    line-height: 1;
    position: absolute;
    right: 1rem;
    top: 0.45rem;
  }

  .swimdays-our-story__note-name {
    position: relative;
    z-index: 1;
  }

  .swimdays-our-story__note-quote {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .swimdays-our-story__cta {
    align-items: center;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.3)),
      rgba(52, 86, 91, 0.08);
    border: 1px solid rgba(52, 86, 91, 0.12);
    display: grid;
    gap: 1rem;
    justify-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    text-align: center;
  }

  .swimdays-our-story__cta-copy {
    max-width: min(100%, 46ch);
  }

  .swimdays-our-story__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .swimdays-our-story__cta-button {
    align-items: center;
    border: 1px solid transparent;
    color: inherit;
    display: inline-flex;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: 0.8rem;
    justify-content: center;
    letter-spacing: 0.12em;
    min-height: 3rem;
    min-width: clamp(10rem, 18vw, 12.5rem);
    padding: 0.9rem 1.4rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .swimdays-our-story__cta-button--primary {
    background: #2e2b26;
    color: #fff;
  }

  .swimdays-our-story__cta-button--secondary {
    border-color: rgba(46, 43, 38, 0.18);
    color: #2e2b26;
  }

  .swimdays-our-story__cta-button:hover {
    transform: translateY(-1px);
  }

  .swimdays-our-story__cta-button--primary:hover {
    background: #1f1c18;
  }

  .swimdays-our-story__cta-button--secondary:hover {
    background: rgba(46, 43, 38, 0.04);
    border-color: rgba(46, 43, 38, 0.28);
  }

  .swimdays-our-story__cta-button:focus-visible {
    outline: 2px solid #2e2b26;
    outline-offset: 3px;
  }

  @container (min-width: 40rem) {
    .swimdays-our-story__notes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 960px) {
    .swimdays-our-story {
      padding-top: clamp(3rem, 4vw, 4.5rem);
    }

    .swimdays-our-story__hero {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .swimdays-our-story__hero-copy {
      padding-inline: clamp(0.5rem, 2vw, 2rem) clamp(0, 3vw, 2rem);
    }

    .swimdays-our-story__story {
      gap: 1.25rem;
      grid-template-columns: minmax(0, 11rem) minmax(0, 46rem);
    }

    .swimdays-our-story__section-meta {
      padding-top: 0.35rem;
    }

    .swimdays-our-story__prose {
      max-width: min(100%, 68ch);
    }
  }

  @media screen and (max-width: 959px) {
    .swimdays-our-story__hero-copy {
      padding-inline: clamp(0.25rem, 2vw, 0.5rem);
    }

    .swimdays-our-story__title {
      max-width: 10ch;
    }
  }

  @media screen and (max-width: 639px) {
    .swimdays-our-story {
      padding-inline: 1rem;
    }

    .swimdays-our-story__hero-placeholder,
    .swimdays-our-story__hero-image {
      aspect-ratio: 4 / 5.2;
    }

    .swimdays-our-story__hero-media::after {
      inset: 0.7rem;
    }

    .swimdays-our-story__title {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }

    .swimdays-our-story__intro p,
    .swimdays-our-story__prose p,
    .swimdays-our-story__goal-copy p,
    .swimdays-our-story__note-quote p,
    .swimdays-our-story__cta-copy p {
      font-size: 0.98rem;
      line-height: 1.72;
    }

    .swimdays-our-story__essence {
      margin-inline: -1rem;
    }

    .swimdays-our-story__cta-button {
      min-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swimdays our story",
  "tag": "section",
  "class": "shopify-section--swimdays-our-story",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Assign this section through the Our Story page template and upload the founders' portrait in the image setting below."
    },
    {
      "type": "image_picker",
      "id": "founders_portrait",
      "label": "Founders portrait"
    },
    {
      "type": "text",
      "id": "founders_portrait_alt",
      "label": "Founders portrait alt text",
      "default": "Portrait of the Swimdays founders"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Inspired from Sundays"
    },
    {
      "type": "textarea",
      "id": "hero_intro",
      "label": "Hero intro",
      "default": "For two sisters in India, summer Sundays once meant early-morning pool sessions, hearty breakfasts, and a search for swimwear that never felt quite right."
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Story section label",
      "default": "The Beginning"
    },
    {
      "type": "textarea",
      "id": "story_paragraph_1",
      "label": "Story paragraph 1",
      "default": "For the two sisters in India, their summer Sundays during childhood meant ‘swim-days’. Early morning pool sessions and plunges, followed by a hearty-brekkie meant the world to us. However, our sunny mornings were often clouded by the stressful bag packing where we barely managed to find ourselves suitable swims."
    },
    {
      "type": "textarea",
      "id": "story_paragraph_2",
      "label": "Story paragraph 2",
      "default": "Our manifesto included modest coverage, lovely colours, comfortable fabric and sun protection. Unfortunately, this deal was unavailable across the gigantic Indian market. The horrors followed us through many beach vacations and weekend getaways too!"
    },
    {
      "type": "textarea",
      "id": "story_paragraph_3",
      "label": "Story paragraph 3",
      "default": "Many years later, on a fine Sunday morning in July, 2024, before leaving home for yet another swim session, we decided to fill the void and create swimwear that would resonate with girls like us who scroll endlessly on their shopping screens, to never find their favourite picks."
    },
    {
      "type": "textarea",
      "id": "story_paragraph_4",
      "label": "Story paragraph 4",
      "default": "We share our Sunday swim nostalgia through Swimdays and aim to enhance the beachwear and swimwear experience with inclusivity at the core!"
    },
    {
      "type": "textarea",
      "id": "brand_essence",
      "label": "Brand essence statement",
      "default": "With middle-Eastern design aesthetics transcended into the vivid Indian palette, we crafted an ideal and timeless swim-collection. Embracing the magic of colours and beaded embroidery, our bunch includes separates that allows you to curate your very own, bespoke ensemble."
    },
    {
      "type": "text",
      "id": "goal_title",
      "label": "Goal heading",
      "default": "OUR GOAL"
    },
    {
      "type": "textarea",
      "id": "goal_body",
      "label": "Goal body",
      "default": "Our goal is to revive modest fashion for women who aspire style and art, particularly for swim and beachwear. Our separates allow you to synergise an ensemble that best suits your personal style and body type. We are here to offer a range of products that deliver modest coverage, premium quality and flattering fits."
    },
    {
      "type": "text",
      "id": "founders_title",
      "label": "Founders section heading",
      "default": "FOUNDERS' NOTE"
    },
    {
      "type": "text",
      "id": "founder_1_name",
      "label": "Founder 1 name",
      "default": "Zahabiya"
    },
    {
      "type": "textarea",
      "id": "founder_1_quote",
      "label": "Founder 1 quote",
      "default": "“Modest swimwear for me is non-conformity to the idea that modest clothing is restrictive, conservative, or boring! I believe it is not merely covering up, it is cherishing the freedom of choice, but fashionably! I don’t wish to fill my swim bag with flimsy, crammed-up and mismatched activewear; I want flattering fits, fabrics and colours that are thoughtfully curated. Now, I wish to offer this for every woman”."
    },
    {
      "type": "text",
      "id": "founder_2_name",
      "label": "Founder 2 name",
      "default": "Fatema"
    },
    {
      "type": "textarea",
      "id": "founder_2_quote",
      "label": "Founder 2 quote",
      "default": "“I believe beach or resort wear was always supposed to evoke a lounging and basking vibe, that’s why we came together to craft a range of artisanal swimwear which is comfortable and has an ease of styling. I like to define my own standards when it comes to fashion trends, without feeling sidetracked or overlooked. Our designs encompass a whole spectrum of modesty, in a fun and creative way”."
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Explore the collections"
    },
    {
      "type": "textarea",
      "id": "cta_body",
      "label": "CTA body",
      "default": "Move from the story into the silhouettes, colours, and separates that make up Swimdays."
    },
