{% javascript %}
  (() => {
    const SECTION_SELECTOR = '[data-swimdays-home-testimonials]';
    const VIEWPORT_SELECTOR = '[data-testimonials-viewport]';
    const RAIL_SELECTOR = '[data-testimonials-rail]';
    const CARD_SELECTOR = '[data-testimonial-card]';
    const LIGHTBOX_SELECTOR = '[data-testimonial-lightbox]';
    const LIGHTBOX_TRIGGER_SELECTOR = '[data-testimonial-lightbox-trigger]';
    const LIGHTBOX_CLOSE_SELECTOR = '[data-testimonial-lightbox-close]';
    const LIGHTBOX_IMAGE_SELECTOR = '[data-testimonial-lightbox-image]';
    const LIGHTBOX_CAPTION_SELECTOR = '[data-testimonial-lightbox-caption]';
    const LIGHTBOX_OPEN_CLASS = 'swimdays-testimonials-lightbox-open';

    const parseDateValue = (card) => {
      const rawDate = card.dataset.testimonialDate || '';
      const parsedDate = Date.parse(rawDate);

      if (Number.isNaN(parsedDate)) return 0;

      return parsedDate;
    };

    const getFocusableElements = (container) => {
      return Array.from(
        container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter((element) => element.offsetParent !== null);
    };

    const prepareRail = (rail, viewport) => {
      const cards = Array.from(rail.querySelectorAll(`${CARD_SELECTOR}:not([data-testimonial-clone])`));

      cards
        .sort((firstCard, secondCard) => {
          const dateDiff = parseDateValue(secondCard) - parseDateValue(firstCard);

          if (dateDiff !== 0) return dateDiff;

          const firstIndex = Number(firstCard.dataset.testimonialIndex || 0);
          const secondIndex = Number(secondCard.dataset.testimonialIndex || 0);

          return firstIndex - secondIndex;
        })
        .forEach((card) => rail.appendChild(card));

      rail.querySelectorAll('[data-testimonial-clone]').forEach((clone) => clone.remove());

      if (cards.length < 2) return 0;

      const loopPoint = rail.scrollWidth;
      let clonePasses = 0;

      while (rail.scrollWidth < loopPoint + viewport.clientWidth && clonePasses < 6) {
        for (const card of cards) {
          const clone = card.cloneNode(true);
          Array.from(clone.attributes).forEach((attribute) => {
            if (attribute.name.startsWith('data-shopify')) {
              clone.removeAttribute(attribute.name);
            }
          });
          clone.dataset.testimonialClone = 'true';
          clone.setAttribute('aria-hidden', 'true');

          clone.querySelectorAll('a, button, input, select, textarea').forEach((element) => {
            element.setAttribute('tabindex', '-1');
          });

          rail.appendChild(clone);
        }

        clonePasses += 1;
      }

      return loopPoint;
    };

    const getRailGap = (rail) => {
      const styles = window.getComputedStyle(rail);
      const gap = parseFloat(styles.columnGap || styles.gap || '0');

      if (Number.isNaN(gap)) return 0;

      return gap;
    };

    const initTestimonials = (root = document) => {
      const sections = root.querySelectorAll(SECTION_SELECTOR);

      for (const section of sections) {
        if (section.dataset.testimonialsInitialized === 'true') continue;

        const viewport = section.querySelector(VIEWPORT_SELECTOR);
        const rail = section.querySelector(RAIL_SELECTOR);
        const lightbox = section.querySelector(LIGHTBOX_SELECTOR);

        if (!(viewport && rail)) continue;

        section.dataset.testimonialsInitialized = 'true';

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const speed = Math.max(0, Number(section.dataset.autoplaySpeed || 14));
        const pauseReasons = new Set();
        const state = {
          activeTrigger: null,
          frame: null,
          lastTimestamp: 0,
          loopPoint: prepareRail(rail, viewport),
          paused: reducedMotion.matches || speed === 0,
          position: viewport.scrollLeft,
        };

        const canScroll = () => state.loopPoint > 0 && viewport.scrollWidth > viewport.clientWidth + 2;

        const updatePausedState = () => {
          state.paused = pauseReasons.size > 0 || reducedMotion.matches || speed === 0;
        };

        const pauseFor = (reason) => {
          pauseReasons.add(reason);
          updatePausedState();
        };

        const resumeFor = (reason) => {
          pauseReasons.delete(reason);
          updatePausedState();
        };

        const clearWave = () => {
          rail.querySelectorAll(CARD_SELECTOR).forEach((card) => {
            card.style.setProperty('--testimonial-wave-y', '0px');
          });
        };

        const updateWave = () => {
          const cards = Array.from(rail.querySelectorAll(CARD_SELECTOR));

          if (reducedMotion.matches || cards.length === 0) {
            clearWave();
            return;
          }

          const firstCard = cards[0];
          const firstRect = firstCard.getBoundingClientRect();
          const stride = firstRect.width + getRailGap(rail);

          if (stride <= 0) {
            clearWave();
            return;
          }

          const viewportRect = viewport.getBoundingClientRect();
          const amplitude = viewport.clientWidth < 750 ? 7 : 16;

          cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const positionInSlots = (rect.left - viewportRect.left) / stride;
            const offset = Math.cos(positionInSlots * Math.PI) * -amplitude;

            card.style.setProperty('--testimonial-wave-y', `${offset.toFixed(2)}px`);
          });
        };

        const tick = (timestamp) => {
          if (!state.lastTimestamp) state.lastTimestamp = timestamp;

          const delta = timestamp - state.lastTimestamp;
          state.lastTimestamp = timestamp;

          if (!state.paused && canScroll()) {
            state.position += (speed * delta) / 1000;

            if (state.position >= state.loopPoint) {
              state.position -= state.loopPoint;
            }

            viewport.scrollLeft = state.position;
          } else {
            state.position = viewport.scrollLeft;
          }

          updateWave();

          state.frame = window.requestAnimationFrame(tick);
        };

        const handleReducedMotion = () => {
          updatePausedState();
          updateWave();
        };
        const pausePointer = () => pauseFor('pointer');
        const resumePointer = () => {
          state.position = viewport.scrollLeft;
          resumeFor('pointer');
        };
        const pauseFocus = () => pauseFor('focus');
        const resumeFocus = (event) => {
          if (event.relatedTarget && viewport.contains(event.relatedTarget)) return;

          state.position = viewport.scrollLeft;
          resumeFor('focus');
        };
        const handleScroll = () => {
          if (state.paused) {
            state.position = viewport.scrollLeft;
          }

          updateWave();
        };
        const handleResize = () => {
          state.position = viewport.scrollLeft;
          state.loopPoint = prepareRail(rail, viewport);
          updateWave();
        };
        const closeLightbox = () => {
          if (!lightbox || lightbox.hidden) return;

          const image = lightbox.querySelector(LIGHTBOX_IMAGE_SELECTOR);
          const caption = lightbox.querySelector(LIGHTBOX_CAPTION_SELECTOR);
          const trigger = state.activeTrigger;

          lightbox.hidden = true;
          lightbox.removeAttribute('data-open');
          document.documentElement.classList.remove(LIGHTBOX_OPEN_CLASS);
          resumeFor('lightbox');

          if (image) {
            image.removeAttribute('src');
            image.alt = '';
          }

          if (caption) {
            caption.textContent = '';
          }

          state.activeTrigger = null;

          if (trigger && document.contains(trigger)) {
            trigger.focus({ preventScroll: true });
          }
        };
        const openLightbox = (trigger) => {
          if (!lightbox || !trigger) return;

          const image = lightbox.querySelector(LIGHTBOX_IMAGE_SELECTOR);
          const caption = lightbox.querySelector(LIGHTBOX_CAPTION_SELECTOR);
          const closeButton = lightbox.querySelector(LIGHTBOX_CLOSE_SELECTOR);
          const src = trigger.dataset.testimonialLightboxSrc;

          if (!(image && src)) return;

          state.activeTrigger = trigger;
          image.src = src;
          image.alt = trigger.dataset.testimonialLightboxAlt || '';

          if (caption) {
            caption.textContent = trigger.dataset.testimonialLightboxCaption || '';
          }

          lightbox.hidden = false;
          lightbox.setAttribute('data-open', 'true');
          document.documentElement.classList.add(LIGHTBOX_OPEN_CLASS);
          pauseFor('lightbox');

          if (closeButton) {
            closeButton.focus({ preventScroll: true });
          }
        };
        const handleSectionClick = (event) => {
          const closeTrigger = event.target.closest(LIGHTBOX_CLOSE_SELECTOR);

          if (closeTrigger && lightbox && lightbox.contains(closeTrigger)) {
            closeLightbox();
            return;
          }

          const lightboxTrigger = event.target.closest(LIGHTBOX_TRIGGER_SELECTOR);

          if (lightboxTrigger && section.contains(lightboxTrigger)) {
            event.preventDefault();
            openLightbox(lightboxTrigger);
          }
        };
        const handleKeydown = (event) => {
          if (!lightbox || lightbox.hidden) return;

          if (event.key === 'Escape') {
            event.preventDefault();
            closeLightbox();
            return;
          }

          if (event.key !== 'Tab') return;

          const focusableElements = getFocusableElements(lightbox);

          if (focusableElements.length === 0) return;

          const firstElement = focusableElements[0];
          const lastElement = focusableElements[focusableElements.length - 1];

          if (event.shiftKey && document.activeElement === firstElement) {
            event.preventDefault();
            lastElement.focus();
          } else if (!event.shiftKey && document.activeElement === lastElement) {
            event.preventDefault();
            firstElement.focus();
          }
        };

        viewport.addEventListener('pointerenter', pausePointer);
        viewport.addEventListener('pointerleave', resumePointer);
        viewport.addEventListener('focusin', pauseFocus);
        viewport.addEventListener('focusout', resumeFocus);
        viewport.addEventListener('scroll', handleScroll, { passive: true });
        section.addEventListener('click', handleSectionClick);
        document.addEventListener('keydown', handleKeydown);
        window.addEventListener('resize', handleResize);
        reducedMotion.addEventListener('change', handleReducedMotion);

        updateWave();
        state.frame = window.requestAnimationFrame(tick);
        section._swimdaysTestimonialsCleanup = () => {
          closeLightbox();
          if (state.frame) window.cancelAnimationFrame(state.frame);
          viewport.removeEventListener('pointerenter', pausePointer);
          viewport.removeEventListener('pointerleave', resumePointer);
          viewport.removeEventListener('focusin', pauseFocus);
          viewport.removeEventListener('focusout', resumeFocus);
          viewport.removeEventListener('scroll', handleScroll);
          section.removeEventListener('click', handleSectionClick);
          document.removeEventListener('keydown', handleKeydown);
          window.removeEventListener('resize', handleResize);
          reducedMotion.removeEventListener('change', handleReducedMotion);
          rail.querySelectorAll('[data-testimonial-clone]').forEach((clone) => clone.remove());
          delete section.dataset.testimonialsInitialized;
        };
      }
    };

    const cleanupTestimonials = (section) => {
      if (section && section._swimdaysTestimonialsCleanup) {
        section._swimdaysTestimonialsCleanup();
        delete section._swimdaysTestimonialsCleanup;
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initTestimonials());
    } else {
      initTestimonials();
    }

    document.addEventListener('shopify:section:load', (event) => initTestimonials(event.target));
    document.addEventListener('shopify:section:unload', (event) => cleanupTestimonials(event.target));
  })();
{% endjavascript %}

