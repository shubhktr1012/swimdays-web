{% liquid
  assign heading_prefix = section.settings.heading_prefix | default: 'Seen on'
  assign heading_accent = section.settings.heading_accent | default: 'Instagram'
  assign heading_suffix = section.settings.heading_suffix | default: ''
  assign intro_text = section.settings.intro_text
  assign cta_label = section.settings.cta_label | default: 'Follow @swimdays.shop'
  assign watch_cta_label = section.settings.watch_cta_label | default: 'Watch on Instagram'
  assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/swimdays.shop/?hl=en'
  assign preview_seconds = section.settings.preview_seconds | default: 6
  assign show_watch_cta = section.settings.show_watch_cta
  if show_watch_cta == blank
    assign show_watch_cta = true
  endif
%}

{% render 'swimdays-home-fonts' %}

<section
  id="swimdays-home-instagram-{{ section.id }}"
  class="swimdays-home-instagram"
  data-swimdays-home-instagram
  data-section-id="{{ section.id }}"
>
  <div class="swimdays-home-instagram__inner">
    <header class="swimdays-home-instagram__head">
      <h2 class="swimdays-home-instagram__title">
        {{ heading_prefix }}
        <span class="swimdays-home-instagram__accent">{{ heading_accent }}</span>
        {{ heading_suffix }}
      </h2>

      {% if intro_text != blank %}
        <p class="swimdays-home-instagram__intro">{{ intro_text }}</p>
      {% endif %}
    </header>

    <div class="swimdays-home-instagram__grid">
      {% for block in section.blocks %}
        {% liquid
          assign tile_media_type = block.settings.media_type | default: 'image'
          assign tile_image = block.settings.image
          assign tile_video = block.settings.video
          assign tile_video_thumbnail = block.settings.video_thumbnail
          assign tile_link = block.settings.link
          assign tile_alt = block.settings.alt_text | default: 'Swimdays Instagram post'
          assign watch_cta_text = watch_cta_label | replace: 'Instagram', '' | replace: 'instagram', '' | strip
          if watch_cta_text == blank
            assign watch_cta_text = 'Watch on'
          endif

          if tile_video_thumbnail == blank and tile_video != blank
            assign tile_video_thumbnail = tile_video.preview_image
          endif

          assign tile_video_thumbnail_height = 900
          if tile_video_thumbnail != blank and tile_video_thumbnail.aspect_ratio != blank
            assign tile_video_thumbnail_height = 900 | divided_by: tile_video_thumbnail.aspect_ratio | round
          endif

          assign tile_image_height = 900
          if tile_image != blank and tile_image.aspect_ratio != blank
            assign tile_image_height = 900 | divided_by: tile_image.aspect_ratio | round
          endif
        %}

        <article class="swimdays-home-instagram__tile" {{ block.shopify_attributes }}>
          {% if tile_link != blank %}
            <a
              class="swimdays-home-instagram__tile-link"
              href="{{ tile_link }}"
              aria-label="{{ watch_cta_text }} Instagram post"
              {% if section.settings.open_links_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {% endif %}

          <div class="swimdays-home-instagram__media">
            {% if tile_media_type == 'video' and tile_video != blank %}
              <div
                class="swimdays-home-instagram__video-shell"
                data-swimdays-instagram-preview
                data-preview-seconds="{{ preview_seconds }}"
              >
                {{
                  tile_video
                  | video_tag:
                    poster: nil,
                    autoplay: false,
                    loop: false,
                    controls: false,
                    muted: true,
                    playsinline: true,
                    preload: 'none',
                    class: 'swimdays-home-instagram__asset swimdays-home-instagram__video'
                }}

                {% if tile_video_thumbnail != blank %}
                  {{
                    tile_video_thumbnail
                    | image_url: width: 900
                    | image_tag:
                      class: 'swimdays-home-instagram__thumbnail',
                      alt: tile_alt,
                      width: 900,
                      height: tile_video_thumbnail_height,
                      widths: '280, 360, 480, 640, 900',
                      sizes: '(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 16vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="swimdays-home-instagram__placeholder" aria-hidden="true">
                    {{ 'image' | placeholder_svg_tag: 'swimdays-home-instagram__placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
            {% elsif tile_image != blank %}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  class: 'swimdays-home-instagram__asset swimdays-home-instagram__image',
                  alt: tile_alt,
                  width: 900,
                  height: tile_image_height,
                  widths: '280, 360, 480, 640, 900',
                  sizes: '(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 16vw',
                  loading: 'lazy'
              }}
            {% elsif tile_video != blank %}
              <div
                class="swimdays-home-instagram__video-shell"
                data-swimdays-instagram-preview
                data-preview-seconds="{{ preview_seconds }}"
              >
                {{
                  tile_video
                  | video_tag:
                    poster: nil,
                    autoplay: false,
                    loop: false,
                    controls: false,
                    muted: true,
                    playsinline: true,
                    preload: 'none',
                    class: 'swimdays-home-instagram__asset swimdays-home-instagram__video'
                }}

                {% if tile_video_thumbnail != blank %}
                  {{
                    tile_video_thumbnail
                    | image_url: width: 900
                    | image_tag:
                      class: 'swimdays-home-instagram__thumbnail',
                      alt: tile_alt,
                      width: 900,
                      height: tile_video_thumbnail_height,
                      widths: '280, 360, 480, 640, 900',
                      sizes: '(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 16vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  <div class="swimdays-home-instagram__placeholder" aria-hidden="true">
                    {{ 'image' | placeholder_svg_tag: 'swimdays-home-instagram__placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
            {% else %}
              <div class="swimdays-home-instagram__placeholder" aria-hidden="true">
                {{ 'image' | placeholder_svg_tag: 'swimdays-home-instagram__placeholder-svg' }}
              </div>
            {% endif %}

            {% if tile_link != blank and show_watch_cta %}
              <span class="swimdays-home-instagram__watch-cta">
                <span>{{ watch_cta_text }}</span>
                <span class="swimdays-home-instagram__ig-icon swimdays-home-instagram__ig-icon--tiny swimdays-home-instagram__ig-icon--mono" aria-hidden="true">
                  <span class="swimdays-home-instagram__ig-icon-lens"></span>
                </span>
              </span>
            {% endif %}
          </div>

          {% if tile_link != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if instagram_url != blank %}
      <div class="swimdays-home-instagram__footer">
        <a
          class="swimdays-home-instagram__cta"
          href="{{ instagram_url }}"
          {% if section.settings.open_links_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          <span class="swimdays-home-instagram__ig-icon swimdays-home-instagram__ig-icon--small" aria-hidden="true">
            <span class="swimdays-home-instagram__ig-icon-lens"></span>
          </span>
          <span>{{ cta_label }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .swimdays-home-instagram {
    --swimdays-section-space: clamp(3.5rem, 6vw, 5rem);
    background: var(--color-background, #f7f6f2);
    padding-block: var(--swimdays-section-space);
  }

  .swimdays-home-instagram__inner {
    margin: 0 auto;
    width: min(100%, 1600px);
  }

  .swimdays-home-instagram__head {
    margin: 0 0 clamp(1.05rem, 2vw, 1.5rem);
    text-align: center;
  }

  .swimdays-home-instagram__title {
    color: #2e2b26;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.8rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    margin: 0;
    text-transform: none;
  }

  .swimdays-home-instagram__accent {
    font-family: "Swimdays Accent", cursive;
    font-size: 1.08em;
    letter-spacing: 0;
    margin: 0 0.12em;
    text-transform: none;
  }

  .swimdays-home-instagram__ig-icon {
    align-items: center;
    background:
      radial-gradient(circle at 32% 110%, #fdf497 0%, #fdf497 9%, #fd5949 46%, #d6249f 68%, #285aeb 100%);
    border-radius: 0.34em;
    display: inline-flex;
    flex: 0 0 auto;
    height: 1em;
    justify-content: center;
    position: relative;
    width: 1em;
  }

  .swimdays-home-instagram__ig-icon::before {
    border: 1.35px solid #fff;
    border-radius: 0.24em;
    content: "";
    inset: 18%;
    position: absolute;
  }

  .swimdays-home-instagram__ig-icon-lens {
    border: 1.35px solid #fff;
    border-radius: 50%;
    height: 34%;
    width: 34%;
    z-index: 1;
  }

  .swimdays-home-instagram__ig-icon-lens::before {
    background: #fff;
    border-radius: 50%;
    content: "";
    height: 18%;
    position: absolute;
    right: 22%;
    top: 22%;
    width: 18%;
  }

  .swimdays-home-instagram__ig-icon--title {
    font-size: 0.74em;
    margin: 0 0.15em 0 0.08em;
    transform: translateY(0.04em);
  }

  .swimdays-home-instagram__ig-icon--small {
    font-size: 1rem;
  }

  .swimdays-home-instagram__ig-icon--tiny {
    font-size: 0.78rem;
  }

  .swimdays-home-instagram__ig-icon--mono {
    background: #111;
  }

  .swimdays-home-instagram__intro {
    color: #4a463f;
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(0.9rem, 0.84rem + 0.18vw, 1rem);
    line-height: 1.55;
    margin: 0.55rem auto 0;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .swimdays-home-instagram__grid {
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    width: 100%;
  }

  .swimdays-home-instagram__tile {
    display: block;
    min-width: 0;
  }

  .swimdays-home-instagram__tile-link {
    color: inherit;
    display: block;
    text-decoration: none;
  }

  .swimdays-home-instagram__tile-link:focus-visible {
    outline: 2px solid #2e2b26;
    outline-offset: 2px;
  }

  .swimdays-home-instagram__media {
    aspect-ratio: 9 / 16;
    background: #f2ebe2;
    overflow: hidden;
    position: relative;
  }

  .swimdays-home-instagram__asset {
    display: block;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: transform 0.35s ease;
    width: 100%;
  }

  .swimdays-home-instagram__video {
    background: #000;
  }

  .swimdays-home-instagram__video-shell {
    height: 100%;
    position: relative;
    width: 100%;
  }

  .swimdays-home-instagram__video-shell .swimdays-home-instagram__video {
    inset: 0;
    position: absolute;
  }

  .swimdays-home-instagram__thumbnail {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    pointer-events: none;
    position: absolute;
    transition: opacity 0.22s ease;
    width: 100%;
    z-index: 2;
  }

  .swimdays-home-instagram__video-shell.is-previewing .swimdays-home-instagram__thumbnail {
    opacity: 0;
  }

  .swimdays-home-instagram__tile-link:hover .swimdays-home-instagram__asset {
    transform: scale(1.02);
  }

  .swimdays-home-instagram__watch-cta {
    align-items: center;
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    bottom: 0.65rem;
    color: #fff;
    display: inline-flex;
    gap: 0.35rem;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: 0.66rem;
    font-weight: 500;
    left: 50%;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.48rem 0.72rem;
    pointer-events: none;
    position: absolute;
    text-transform: uppercase;
    transform: translate(-50%, 6px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    white-space: nowrap;
    z-index: 3;
    opacity: 0;
  }

  .swimdays-home-instagram__tile-link:hover .swimdays-home-instagram__watch-cta,
  .swimdays-home-instagram__tile-link:focus-visible .swimdays-home-instagram__watch-cta {
    opacity: 1;
    transform: translateX(-50%);
  }

  @media (hover: none), (pointer: coarse) {
    .swimdays-home-instagram__watch-cta {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  .swimdays-home-instagram__placeholder {
    align-items: center;
    color: rgba(46, 43, 38, 0.2);
    display: grid;
    height: 100%;
    place-content: center;
    width: 100%;
  }

  .swimdays-home-instagram__placeholder-svg {
    height: 42%;
    width: 42%;
  }

  .swimdays-home-instagram__footer {
    margin-top: clamp(0.9rem, 1.6vw, 1.25rem);
    text-align: center;
  }

  .swimdays-home-instagram__cta {
    border-bottom: 1px solid #2e2b26;
    color: #2e2b26;
    display: inline-flex;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: clamp(0.75rem, 0.7rem + 0.18vw, 0.86rem);
    gap: 0.45rem;
    letter-spacing: 0.08em;
    padding-bottom: 0.15rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  .swimdays-home-instagram__cta:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 1099px) {
    .swimdays-home-instagram__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .swimdays-home-instagram__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .swimdays-home-instagram__watch-cta {
      opacity: 1;
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const SECTION_SELECTOR = '[data-swimdays-home-instagram]';
    const PREVIEW_SELECTOR = '[data-swimdays-instagram-preview]';
    const DESKTOP_HOVER_QUERY = '(hover: hover) and (pointer: fine)';

    const initSection = (scope = document) => {
      const sectionRoots = scope.matches?.(SECTION_SELECTOR) ? [scope] : scope.querySelectorAll?.(SECTION_SELECTOR);
      if (!sectionRoots || !sectionRoots.length) return;

      const canHover = window.matchMedia(DESKTOP_HOVER_QUERY).matches;

      sectionRoots.forEach((section) => {
        section.querySelectorAll(PREVIEW_SELECTOR).forEach((shell) => {
          if (shell.dataset.previewInit === 'true') return;

          const video = shell.querySelector('video');
          if (!video) return;

          shell.dataset.previewInit = 'true';
          video.muted = true;
          video.playsInline = true;

          let stopTimer = null;

          const clearTimer = () => {
            if (stopTimer) {
              window.clearTimeout(stopTimer);
              stopTimer = null;
            }
          };

          const stopPreview = () => {
            clearTimer();
            video.pause();
            try {
              video.currentTime = 0;
            } catch (error) {}
            shell.classList.remove('is-previewing');
          };

          const startPreview = () => {
            if (!canHover) return;

            clearTimer();
            shell.classList.add('is-previewing');
            try {
              video.currentTime = 0;
            } catch (error) {}

            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch(() => {});
            }

            const seconds = Number(shell.dataset.previewSeconds || 6);
            const durationMs = Math.min(Math.max(seconds, 1), 15) * 1000;
            stopTimer = window.setTimeout(stopPreview, durationMs);
          };

          shell.addEventListener('mouseenter', startPreview);
          shell.addEventListener('mouseleave', stopPreview);
          shell.addEventListener('focusin', startPreview);
          shell.addEventListener('focusout', stopPreview);
          stopPreview();
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initSection(document));
    } else {
      initSection(document);
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target) initSection(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Swimdays Instagram",
  "tag": "section",
  "class": "shopify-section--swimdays-home-instagram",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "default": "Seen on"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Add recent @swimdays.shop posts here for a clean, free Instagram look on the homepage."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL (defaults to @swimdays.shop)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Profile link label",
      "default": "Follow @swimdays.shop"
    },
    {
      "type": "checkbox",
      "id": "show_watch_cta",
      "label": "Show \"Watch on Instagram\" overlay on post tiles",
      "default": true
    },
    {
      "type": "text",
      "id": "watch_cta_label",
      "label": "Post tile overlay label",
      "default": "Watch on"
    },
    {
      "type": "range",
      "id": "preview_seconds",
      "label": "Desktop video preview duration (seconds)",
      "min": 5,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "open_links_new_tab",
      "label": "Open links in a new tab",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "video_thumbnail",
          "label": "Video thumbnail (shown before hover preview)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swimdays Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
