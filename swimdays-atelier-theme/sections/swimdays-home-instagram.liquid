{% liquid
  assign heading_prefix = section.settings.heading_prefix | default: 'Seen on'
  assign heading_accent = section.settings.heading_accent | default: 'Instagram'
  assign heading_suffix = section.settings.heading_suffix | default: ''
  assign intro_text = section.settings.intro_text
  assign cta_label = section.settings.cta_label | default: 'Follow @swimdays.shop'
  assign watch_cta_label = section.settings.watch_cta_label | default: 'Watch on Instagram'
  assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/swimdays.shop/?hl=en'
%}

{% render 'swimdays-home-fonts' %}

<section
  id="swimdays-home-instagram-{{ section.id }}"
  class="swimdays-home-instagram"
  data-swimdays-home-instagram
  data-section-id="{{ section.id }}"
>
  <div class="swimdays-home-instagram__inner">
    <header class="swimdays-home-instagram__head">
      <h2 class="swimdays-home-instagram__title">
        {{ heading_prefix }}
        <span class="swimdays-home-instagram__accent">{{ heading_accent }}</span>
        {{ heading_suffix }}
      </h2>

      {% if intro_text != blank %}
        <p class="swimdays-home-instagram__intro">{{ intro_text }}</p>
      {% endif %}
    </header>

    <div class="swimdays-home-instagram__grid">
      {% for block in section.blocks %}
        {% liquid
          assign tile_media_type = block.settings.media_type | default: 'image'
          assign tile_image = block.settings.image
          assign tile_video = block.settings.video
          assign tile_link = block.settings.link
          assign tile_alt = block.settings.alt_text | default: 'Swimdays Instagram post'
        %}

        <article class="swimdays-home-instagram__tile" {{ block.shopify_attributes }}>
          {% if tile_link != blank %}
            <a
              class="swimdays-home-instagram__tile-link"
              href="{{ tile_link }}"
              aria-label="Open Instagram post"
              {% if section.settings.open_links_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {% endif %}

          <div class="swimdays-home-instagram__media">
            {% if tile_media_type == 'video' and tile_video != blank %}
              {{
                tile_video
                | video_tag:
                  poster: nil,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true,
                  class: 'swimdays-home-instagram__asset swimdays-home-instagram__video'
              }}
            {% elsif tile_image != blank %}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  class: 'swimdays-home-instagram__asset swimdays-home-instagram__image',
                  alt: tile_alt,
                  widths: '280, 360, 480, 640, 900',
                  sizes: '(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 16vw',
                  loading: 'lazy'
              }}
            {% elsif tile_video != blank %}
              {{
                tile_video
                | video_tag:
                  poster: nil,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  muted: true,
                  playsinline: true,
                  class: 'swimdays-home-instagram__asset swimdays-home-instagram__video'
              }}
            {% else %}
              <div class="swimdays-home-instagram__placeholder" aria-hidden="true">
                {{ 'image' | placeholder_svg_tag: 'swimdays-home-instagram__placeholder-svg' }}
              </div>
            {% endif %}

            {% if tile_link != blank and section.settings.show_watch_cta %}
              <span class="swimdays-home-instagram__watch-cta">{{ watch_cta_label }}</span>
            {% endif %}
          </div>

          {% if tile_link != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if instagram_url != blank %}
      <div class="swimdays-home-instagram__footer">
        <a
          class="swimdays-home-instagram__cta"
          href="{{ instagram_url }}"
          {% if section.settings.open_links_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .swimdays-home-instagram {
    --swimdays-section-space: clamp(3.5rem, 6vw, 5rem);
    background: var(--color-background, #f7f6f2);
    padding-block: var(--swimdays-section-space);
  }

  .swimdays-home-instagram__inner {
    margin: 0 auto;
    width: min(100%, 1600px);
  }

  .swimdays-home-instagram__head {
    margin: 0 0 clamp(1.05rem, 2vw, 1.5rem);
    text-align: center;
  }

  .swimdays-home-instagram__title {
    color: #2e2b26;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.8rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    margin: 0;
    text-transform: none;
  }

  .swimdays-home-instagram__accent {
    font-family: "Swimdays Accent", cursive;
    font-size: 1.08em;
    letter-spacing: 0;
    margin: 0 0.12em;
    text-transform: none;
  }

  .swimdays-home-instagram__intro {
    color: #4a463f;
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(0.9rem, 0.84rem + 0.18vw, 1rem);
    line-height: 1.55;
    margin: 0.55rem auto 0;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .swimdays-home-instagram__grid {
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    width: 100%;
  }

  .swimdays-home-instagram__tile {
    display: block;
    min-width: 0;
  }

  .swimdays-home-instagram__tile-link {
    color: inherit;
    display: block;
    text-decoration: none;
  }

  .swimdays-home-instagram__tile-link:focus-visible {
    outline: 2px solid #2e2b26;
    outline-offset: 2px;
  }

  .swimdays-home-instagram__media {
    aspect-ratio: 9 / 16;
    background: #f2ebe2;
    overflow: hidden;
    position: relative;
  }

  .swimdays-home-instagram__asset {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    width: 100%;
  }

  .swimdays-home-instagram__video {
    background: #000;
  }

  .swimdays-home-instagram__tile-link:hover .swimdays-home-instagram__asset {
    transform: scale(1.02);
  }

  .swimdays-home-instagram__watch-cta {
    align-items: center;
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    bottom: 0.65rem;
    color: #fff;
    display: inline-flex;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: 0.66rem;
    font-weight: 500;
    left: 50%;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.48rem 0.72rem;
    pointer-events: none;
    position: absolute;
    text-transform: uppercase;
    transform: translateX(-50%);
    white-space: nowrap;
    z-index: 3;
  }

  .swimdays-home-instagram__placeholder {
    align-items: center;
    color: rgba(46, 43, 38, 0.2);
    display: grid;
    height: 100%;
    place-content: center;
    width: 100%;
  }

  .swimdays-home-instagram__placeholder-svg {
    height: 42%;
    width: 42%;
  }

  .swimdays-home-instagram__footer {
    margin-top: clamp(0.9rem, 1.6vw, 1.25rem);
    text-align: center;
  }

  .swimdays-home-instagram__cta {
    border-bottom: 1px solid #2e2b26;
    color: #2e2b26;
    display: inline-block;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: clamp(0.75rem, 0.7rem + 0.18vw, 0.86rem);
    letter-spacing: 0.08em;
    padding-bottom: 0.15rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  .swimdays-home-instagram__cta:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 1099px) {
    .swimdays-home-instagram__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .swimdays-home-instagram__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swimdays Instagram",
  "tag": "section",
  "class": "shopify-section--swimdays-home-instagram",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "default": "Seen on"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Add recent @swimdays.shop posts here for a clean, free Instagram look on the homepage."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL (defaults to @swimdays.shop)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Profile link label",
      "default": "Follow @swimdays.shop"
    },
    {
      "type": "checkbox",
      "id": "show_watch_cta",
      "label": "Show \"Watch on Instagram\" overlay on post tiles",
      "default": true
    },
    {
      "type": "text",
      "id": "watch_cta_label",
      "label": "Post tile overlay label",
      "default": "Watch on Instagram"
    },
    {
      "type": "checkbox",
      "id": "open_links_new_tab",
      "label": "Open links in a new tab",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swimdays Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
