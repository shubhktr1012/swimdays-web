{% liquid
  assign category_1 = section.settings.collection_1 | default: collections['bodysuits']
  assign category_2 = section.settings.collection_2 | default: collections['halter-swim-dresses']
  assign category_3 = section.settings.collection_3 | default: collections['wrap-tulip-skirts']
  assign category_4 = section.settings.collection_4 | default: collections['swim-leggings']
  assign category_5 = section.settings.collection_5 | default: collections['swim-shorts']

  assign label_1 = category_1.title | default: 'Bodysuits'
  assign label_2 = category_2.title | default: 'Halter Swim Dresses'
  assign label_3 = category_3.title | default: 'Wrap Tulip Skirts'
  assign label_4 = category_4.title | default: 'Swim Leggings'
  assign label_5 = category_5.title | default: 'Swim Shorts'

  assign category_image_1 = category_1.image
  assign category_image_2 = category_2.image
  assign category_image_3 = category_3.image
  assign category_image_4 = category_4.image
  assign category_image_5 = category_5.image
%}

<section
  id="category-section"
  class="swimdays-home-categories"
  style="--swimdays-categories-favicon: url('{{ 'swimdays_favicon.svg' | asset_url }}');"
>
  <h2 class="swimdays-home-categories__heading">
    {{ section.settings.heading_prefix }}
    <span class="swimdays-home-categories__heading-accent">{{ section.settings.heading_accent }}</span>
    {{ section.settings.heading_suffix }}
  </h2>

  <div class="swimdays-home-categories__strip">
    <a class="swimdays-home-categories__item" href="{{ category_1.url | default: routes.all_products_collection_url }}">
      <div class="swimdays-home-categories__placeholder{% if category_image_1 == blank %} swimdays-home-categories__placeholder--fallback{% endif %}" aria-hidden="true">
        {% if category_image_1 != blank %}
          {{ category_image_1 | image_url: width: 900 | image_tag: class: 'swimdays-home-categories__image', alt: '', loading: 'lazy', widths: '240, 320, 480, 640, 900', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw' }}
        {% endif %}
        {% if section.settings.badge_text_1 != blank and section.settings.badge_style_1 != 'none' %}
          <span class="swimdays-home-categories__badge swimdays-home-categories__badge--{{ section.settings.badge_style_1 }}">{{ section.settings.badge_text_1 }}</span>
        {% endif %}
      </div>
      <p class="swimdays-home-categories__label">{{ label_1 }}</p>
    </a>

    <a class="swimdays-home-categories__item" href="{{ category_2.url | default: routes.all_products_collection_url }}">
      <div class="swimdays-home-categories__placeholder{% if category_image_2 == blank %} swimdays-home-categories__placeholder--fallback{% endif %}" aria-hidden="true">
        {% if category_image_2 != blank %}
          {{ category_image_2 | image_url: width: 900 | image_tag: class: 'swimdays-home-categories__image', alt: '', loading: 'lazy', widths: '240, 320, 480, 640, 900', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw' }}
        {% endif %}
        {% if section.settings.badge_text_2 != blank and section.settings.badge_style_2 != 'none' %}
          <span class="swimdays-home-categories__badge swimdays-home-categories__badge--{{ section.settings.badge_style_2 }}">{{ section.settings.badge_text_2 }}</span>
        {% endif %}
      </div>
      <p class="swimdays-home-categories__label">{{ label_2 }}</p>
    </a>

    <a class="swimdays-home-categories__item" href="{{ category_3.url | default: routes.all_products_collection_url }}">
      <div class="swimdays-home-categories__placeholder{% if category_image_3 == blank %} swimdays-home-categories__placeholder--fallback{% endif %}" aria-hidden="true">
        {% if category_image_3 != blank %}
          {{ category_image_3 | image_url: width: 900 | image_tag: class: 'swimdays-home-categories__image', alt: '', loading: 'lazy', widths: '240, 320, 480, 640, 900', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw' }}
        {% endif %}
        {% if section.settings.badge_text_3 != blank and section.settings.badge_style_3 != 'none' %}
          <span class="swimdays-home-categories__badge swimdays-home-categories__badge--{{ section.settings.badge_style_3 }}">{{ section.settings.badge_text_3 }}</span>
        {% endif %}
      </div>
      <p class="swimdays-home-categories__label">{{ label_3 }}</p>
    </a>

    <a class="swimdays-home-categories__item" href="{{ category_4.url | default: routes.all_products_collection_url }}">
      <div class="swimdays-home-categories__placeholder{% if category_image_4 == blank %} swimdays-home-categories__placeholder--fallback{% endif %}" aria-hidden="true">
        {% if category_image_4 != blank %}
          {{ category_image_4 | image_url: width: 900 | image_tag: class: 'swimdays-home-categories__image', alt: '', loading: 'lazy', widths: '240, 320, 480, 640, 900', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw' }}
        {% endif %}
        {% if section.settings.badge_text_4 != blank and section.settings.badge_style_4 != 'none' %}
          <span class="swimdays-home-categories__badge swimdays-home-categories__badge--{{ section.settings.badge_style_4 }}">{{ section.settings.badge_text_4 }}</span>
        {% endif %}
      </div>
      <p class="swimdays-home-categories__label">{{ label_4 }}</p>
    </a>

    <a class="swimdays-home-categories__item" href="{{ category_5.url | default: routes.all_products_collection_url }}">
      <div class="swimdays-home-categories__placeholder{% if category_image_5 == blank %} swimdays-home-categories__placeholder--fallback{% endif %}" aria-hidden="true">
        {% if category_image_5 != blank %}
          {{ category_image_5 | image_url: width: 900 | image_tag: class: 'swimdays-home-categories__image', alt: '', loading: 'lazy', widths: '240, 320, 480, 640, 900', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw' }}
        {% endif %}
        {% if section.settings.badge_text_5 != blank and section.settings.badge_style_5 != 'none' %}
          <span class="swimdays-home-categories__badge swimdays-home-categories__badge--{{ section.settings.badge_style_5 }}">{{ section.settings.badge_text_5 }}</span>
        {% endif %}
      </div>
      <p class="swimdays-home-categories__label">{{ label_5 }}</p>
    </a>
  </div>
</section>

{% stylesheet %}
  .swimdays-home-categories {
    --swimdays-section-space: clamp(3.5rem, 6vw, 5rem);
    background: var(--color-background, #f7f6f2);
    margin-top: 0;
    padding-block: var(--swimdays-section-space);
    width: 100%;
  }

  .swimdays-home-categories__heading {
    color: #2e2b26;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.8rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    margin: 0 0 clamp(0.5rem, 1vw, 0.9rem);
    text-align: center;
    text-transform: none;
  }

  .swimdays-home-categories__heading-accent {
    font-family: "Swimdays Accent", cursive;
    font-size: 1.08em;
    letter-spacing: 0;
    margin: 0 0.12em;
    text-transform: none;
  }

  .swimdays-home-categories__strip {
    align-items: start;
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 2px;
    width: 100%;
  }

  .swimdays-home-categories__item {
    align-content: start;
    color: inherit;
    display: grid;
    gap: clamp(0.35rem, 0.55vw, 0.55rem);
    text-decoration: none;
  }

  .swimdays-home-categories__placeholder {
    aspect-ratio: 4 / 5;
    background: #f7f1e6;
    isolation: isolate;
    overflow: hidden;
    position: relative;
  }

  .swimdays-home-categories__placeholder--fallback {
    background:
      linear-gradient(145deg, rgba(31, 79, 70, 0.14), rgba(31, 79, 70, 0) 60%),
      linear-gradient(315deg, rgba(131, 107, 72, 0.15), rgba(131, 107, 72, 0) 55%),
      #f7f1e6;
  }

  .swimdays-home-categories__placeholder--fallback::after {
    background: var(--swimdays-categories-favicon) center / 58px 58px no-repeat;
    content: "";
    inset: 0;
    opacity: 0.16;
    pointer-events: none;
    position: absolute;
  }

  .swimdays-home-categories__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .swimdays-home-categories__label {
    color: #2e2b26;
    font-family: "Swimdays Subhead", "Poppins", sans-serif;
    font-size: clamp(0.82rem, 0.74rem + 0.22vw, 0.98rem);
    letter-spacing: 0.03em;
    line-height: 1.25;
    margin: 0;
    padding-left: clamp(0.35rem, 0.8vw, 0.7rem);
    padding-top: clamp(0.2rem, 0.4vw, 0.32rem);
    text-align: left;
    text-wrap: balance;
  }

  .swimdays-home-categories__badge {
    -webkit-backdrop-filter: blur(12px) saturate(135%);
    align-items: center;
    backdrop-filter: blur(12px) saturate(135%);
    background: rgba(28, 27, 26, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.62rem;
    justify-content: center;
    left: 0.75rem;
    letter-spacing: 0.11em;
    line-height: 1;
    min-height: 2rem;
    padding: 0.45rem 0.8rem;
    position: absolute;
    text-transform: uppercase;
    top: 0.75rem;
    white-space: nowrap;
    z-index: 2;
  }

  .swimdays-home-categories__badge--new-arrival {
    background: #a84f77;
  }

  .swimdays-home-categories__badge--bestseller {
    background: var(--color-success, #7b8f7f);
  }

  .swimdays-home-categories__item:focus-visible {
    outline: 2px solid #333;
    outline-offset: 0.35rem;
  }

  @media screen and (max-width: 1024px) {
    .swimdays-home-categories__strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2px;
      row-gap: 20px;
    }

    .swimdays-home-categories__heading {
      margin-top: 0;
    }
  }

  @media screen and (max-width: 640px) {
    .swimdays-home-categories__strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

{% endstylesheet %}

{% schema %}
{
