{% liquid
  assign statement_text = section.settings.statement_text
  if statement_text == blank
    assign statement_text = 'Swimdays creates slow-made swimwear where modesty, movement, and craft belong in the same silhouette.'
  endif
%}

<section
  id="brand-statement"
  class="swimdays-home-brand-statement"
  data-swimdays-brand-statement
  data-section-id="{{ section.id }}"
>
  <div class="swimdays-home-brand-statement__shell">
    <article class="swimdays-home-brand-statement__variant">
      <p class="swimdays-home-brand-statement__text">{{ statement_text }}</p>
      <div class="swimdays-home-brand-statement__divider" aria-hidden="true">
        <span class="swimdays-home-brand-statement__divider-line"></span>
        <img
          src="{{ 'flower.svg' | asset_url }}"
          alt=""
          class="swimdays-home-brand-statement__divider-flower"
          width="22"
          height="22"
          loading="lazy"
        >
        <span class="swimdays-home-brand-statement__divider-line"></span>
      </div>
    </article>
  </div>
</section>

{% stylesheet %}
  .swimdays-home-brand-statement {
    --swimdays-section-space: clamp(3.5rem, 6vw, 5rem);
    background: var(--color-background, #f7f6f2);
    border: 0;
    box-shadow: none;
    display: grid;
    margin: 0;
    overflow: clip;
    padding: var(--swimdays-section-space) clamp(1rem, 4vw, 2rem);
    place-items: center;
    position: relative;
    text-align: center;
    width: 100%;
    z-index: 1;
  }

  .swimdays-home-brand-statement__shell {
    display: grid;
    place-items: center;
    position: relative;
    width: min(100%, 1600px);
    z-index: 1;
  }

  .swimdays-home-brand-statement__variant {
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.25rem);
    justify-items: center;
  }

  .swimdays-home-brand-statement__text {
    color: #34565b;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(0.9rem, 0.7rem + 1vw, 1.8rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.35;
    margin: 0;
    max-width: min(85ch, 100%);
    text-wrap: balance;
  }

  .swimdays-home-brand-statement__divider {
    --divider-width: clamp(160px, 24vw, 280px);
    align-items: center;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr auto 1fr;
    width: var(--divider-width);
  }

  .swimdays-home-brand-statement__divider-line {
    background: rgba(168, 79, 119, 0.7);
    display: block;
    height: 1px;
    transform: scaleX(0);
    will-change: transform;
  }

  .swimdays-home-brand-statement__divider-line:first-child {
    transform-origin: right center;
  }

  .swimdays-home-brand-statement__divider-line:last-child {
    transform-origin: left center;
  }

  .swimdays-home-brand-statement__divider-flower {
    display: block;
    filter: brightness(0) saturate(100%) invert(42%) sepia(21%) saturate(1514%) hue-rotate(294deg) brightness(86%) contrast(85%);
    flex: 0 0 auto;
    height: 22px;
    width: 22px;
    will-change: transform;
  }

  .swimdays-home-brand-statement__word {
    display: inline-block;
    will-change: filter, opacity;
  }

  @media screen and (max-width: 749px) {
    .swimdays-home-brand-statement {
      padding: var(--swimdays-section-space) 1rem;
    }

    .swimdays-home-brand-statement__text {
      font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.35rem);
      line-height: 1.45;
      max-width: min(32ch, 100%);
    }

    .swimdays-home-brand-statement__divider {
      gap: 0.75rem;
      width: min(72vw, 220px);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .swimdays-home-brand-statement__text {
      max-width: min(60ch, 100%);
    }
  }

{% endstylesheet %}

{% javascript %}
  (() => {
    const loaderKey = '__swimdaysBrandStatementLoader';

    const loadScript = (src) =>
      new Promise((resolve, reject) => {
        const existing = document.querySelector(`script[data-swimdays-src="${src}"]`);

        if (existing) {
          if (existing.dataset.loaded === 'true') {
            resolve();
            return;
          }

          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.dataset.swimdaysSrc = src;
        script.addEventListener('load', () => {
          script.dataset.loaded = 'true';
          resolve();
        }, { once: true });
        script.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
        document.head.appendChild(script);
      });

    const ensureGsap = async () => {
      if (window.gsap && window.ScrollTrigger) return;

      if (!window[loaderKey]) {
        window[loaderKey] = (async () => {
          await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js');
          await loadScript('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js');
        })();
      }

      await window[loaderKey];
    };

    const splitText = (element) => {
      if (element.dataset.split === 'true') {
        return Array.from(element.querySelectorAll('.swimdays-home-brand-statement__word'));
      }

      const text = element.textContent || '';
      const words = text.trim().split(/\s+/).filter(Boolean);
      const fragment = document.createDocumentFragment();

      element.textContent = '';
      element.setAttribute('aria-label', text.trim());

      for (const word of words) {
        const span = document.createElement('span');
        span.className = 'swimdays-home-brand-statement__word';
        span.textContent = word;
        span.setAttribute('aria-hidden', 'true');
        fragment.appendChild(span);
        fragment.appendChild(document.createTextNode(' '));
      }

      element.appendChild(fragment);
      element.dataset.split = 'true';

      return Array.from(element.querySelectorAll('.swimdays-home-brand-statement__word'));
    };

    const whenNearViewport = (elements, callback) => {
      const targets = Array.from(elements);
      if (!targets.length) return;

      if (!('IntersectionObserver' in window)) {
        callback();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            callback();
          }
        },
        { rootMargin: '200px 0px', threshold: 0.01 }
      );

      targets.forEach((el) => observer.observe(el));
    };

    const initBrandStatement = async (root = document) => {
      const sections = root.querySelectorAll('[data-swimdays-brand-statement]');
      if (!sections.length) return;

      await ensureGsap();
      if (!(window.gsap && window.ScrollTrigger)) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const { gsap, ScrollTrigger } = window;

      gsap.registerPlugin(ScrollTrigger);

      for (const section of sections) {
        if (section.dataset.swimdaysBrandStatementInit === 'true') continue;
        section.dataset.swimdaysBrandStatementInit = 'true';

        const text = section.querySelector('.swimdays-home-brand-statement__text');
        const divider = section.querySelector('.swimdays-home-brand-statement__divider');
        const dividerLines = section.querySelectorAll('.swimdays-home-brand-statement__divider-line');
        const dividerFlower = section.querySelector('.swimdays-home-brand-statement__divider-flower');

        if (!text || !divider || !dividerFlower || !dividerLines.length) continue;

        const syncDividerWidth = () => {
          const textWidth = text.getBoundingClientRect().width;
          const targetWidth = Math.max(140, Math.min(textWidth * 0.8, 360));
          divider.style.setProperty('--divider-width', `${targetWidth}px`);
        };

        syncDividerWidth();
        window.addEventListener('resize', syncDividerWidth);

        if (prefersReducedMotion.matches) {
          dividerLines.forEach((line) => {
            line.style.transform = 'scaleX(1)';
          });
          dividerFlower.style.transform = 'rotate(0deg)';
          continue;
        }

        const words = splitText(text);

        if (words.length) {
          gsap.set(words, {
            opacity: 0.18,
            filter: 'blur(6px)'
          });
        }

        gsap.set(dividerLines, { scaleX: 0 });
        gsap.set(dividerFlower, { rotation: 0 });

        const timeline = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'center center',
            scrub: true
          }
        });

        if (words.length) {
          timeline.to(words, {
            duration: 1,
            ease: 'none',
            filter: 'blur(0px)',
            opacity: 1,
            stagger: {
              amount: 0.82,
              from: 'start'
            }
          }, 0);
        }

        timeline.to(dividerLines, {
          duration: 1,
          ease: 'none',
          scaleX: 1
        }, 0);

        ScrollTrigger.create({
          trigger: section,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
          onUpdate: (self) => {
            gsap.set(dividerFlower, {
              rotation: self.progress * 360
            });
          }
        });
      }
    };

    const bootBrandStatement = (root = document) => {
      const sections = root.querySelectorAll('[data-swimdays-brand-statement]');
      whenNearViewport(sections, () => initBrandStatement(root));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => bootBrandStatement());
    } else {
      bootBrandStatement();
    }

    document.addEventListener('shopify:section:load', (event) => {
      bootBrandStatement(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Swimdays brand statement",
  "tag": "section",
  "class": "shopify-section--swimdays-home-brand-statement",
  "limit": 1,
  "settings": [
    {
      "type": "textarea",
      "id": "statement_text",
      "label": "Statement text",
      "default": "Swimdays creates slow-made swimwear where modesty, movement, and craft belong in the same silhouette."
    }
  ],
  "presets": [
    {
      "name": "Swimdays brand statement"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
