{% liquid
  assign source_collection = section.settings.collection
  assign featured_product = section.settings.featured_product
  assign heading_prefix = section.settings.heading_prefix | default: 'Shop'
  assign heading_accent = section.settings.heading_accent | default: 'all'
  assign heading_suffix = section.settings.heading_suffix | default: 'Products'
  assign view_all_label = section.settings.view_all_label | default: 'View All'
  assign shop_now_label = section.settings.shop_now_label | default: 'Quick Add'
  assign product_limit = section.settings.product_limit | default: 10
  assign source_url = routes.all_products_collection_url

  if source_collection != blank and source_collection.products_count > 0
    assign source_url = source_collection.url
  elsif collections['moss'] != blank
    assign source_url = collections['moss'].url
  elsif collections['cove'] != blank
    assign source_url = collections['cove'].url
  endif
%}

{% render 'swimdays-home-fonts' %}

<section
  id="featured-products"
  class="swimdays-home-shop-all-products featured-section"
  data-swimdays-home-shop-all-products
  data-section-id="{{ section.id }}"
>
  <div class="featured-container">
    <div class="featured-section__head">
      <h2 class="featured-section__title">
        {{ heading_prefix }}
        <span class="featured-section__accent">{{ heading_accent }}</span>
        {{ heading_suffix }}
      </h2>
    </div>

    <div class="featured-scroller" data-featured-scroller>
      {% liquid
        assign rendered_products = 0
      %}

      {% if featured_product != blank %}
        {% render 'swimdays-shop-all-product-card',
          product: featured_product,
          shop_now_label: shop_now_label
        %}

        {% liquid
          assign rendered_products = rendered_products | plus: 1
        %}
      {% endif %}

      {% if source_collection != blank and source_collection.products_count > 0 %}
        {% for product in source_collection.products %}
          {% if rendered_products >= product_limit %}
            {% break %}
          {% endif %}

          {% if featured_product != blank and product.id == featured_product.id %}
            {% continue %}
          {% endif %}

          {% liquid
            assign product_tags_string = product.tags | join: ', ' | downcase
            assign product_type_down = product.type | downcase
            assign is_bag = false

            if product_tags_string contains 'bags' or product_tags_string contains 'island-days' or product_type_down == 'bags' or product_type_down == 'bag' or product_type_down == 'tote'
              assign is_bag = true
            endif
          %}

          {% if is_bag %}
            {% continue %}
          {% endif %}

          {% render 'swimdays-shop-all-product-card',
            product: product,
            shop_now_label: shop_now_label
          %}

          {% liquid
            assign rendered_products = rendered_products | plus: 1
          %}
        {% endfor %}
      {% endif %}

      {% if rendered_products == 0 %}
        {% if collections['moss'] != blank and collections['moss'].products_count > 0 %}
          {% for product in collections['moss'].products %}
            {% if rendered_products >= product_limit %}
              {% break %}
            {% endif %}

            {% render 'swimdays-shop-all-product-card',
              product: product,
              shop_now_label: shop_now_label
            %}

            {% liquid
              assign rendered_products = rendered_products | plus: 1
            %}
          {% endfor %}
        {% endif %}

        {% if rendered_products == 0 and collections['cove'] != blank and collections['cove'].products_count > 0 %}
          {% for product in collections['cove'].products %}
            {% if rendered_products >= product_limit %}
              {% break %}
            {% endif %}

            {% render 'swimdays-shop-all-product-card',
              product: product,
              shop_now_label: shop_now_label
            %}

            {% liquid
              assign rendered_products = rendered_products | plus: 1
            %}
          {% endfor %}
        {% endif %}
      {% endif %}

      {% if rendered_products == 0 %}
        <article class="swimdays-product-card">
          <div class="swimdays-product-card__link">
            <div class="swimdays-product-card__image-wrapper"></div>
            <div class="swimdays-product-card__info">
              <h3 class="swimdays-product-card__title">Add products to the selected collection</h3>
              <p class="swimdays-product-card__price">Shopify collection is currently empty</p>
            </div>
          </div>
        </article>
      {% endif %}
    </div>

    <div class="featured-section__footer">
      <button class="featured-nav-btn prev" type="button">
        <span aria-hidden="true">Prev</span>
        <span class="visually-hidden">Scroll products backward</span>
      </button>
      <span class="featured-nav-separator" aria-hidden="true">|</span>
      <a
        class="featured-section__cta"
        href="{{ source_url }}"
        aria-label="{{ view_all_label }} products"
      >
        {{ view_all_label }}
      </a>
      <span class="featured-nav-separator" aria-hidden="true">|</span>
      <button class="featured-nav-btn next" type="button">
        <span aria-hidden="true">Next</span>
        <span class="visually-hidden">Scroll products forward</span>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  .swimdays-home-shop-all-products {
    --swimdays-section-space: clamp(3.5rem, 6vw, 5rem);
    background-color: var(--color-background, #f7f6f2);
    padding: var(--swimdays-section-space) 0;
  }

  .swimdays-home-shop-all-products .featured-container {
    margin: 0;
    width: 100%;
  }

  .swimdays-home-shop-all-products .featured-section__head {
    align-items: center;
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(1rem, 2vw, 1.4rem);
  }

  .swimdays-home-shop-all-products .featured-section__title {
    color: #2e2b26;
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: clamp(1.35rem, 1.65vw, 2rem);
    font-weight: 400;
    margin: 0;
  }

  .swimdays-home-shop-all-products .featured-section__accent {
    font-family: "Swimdays Accent", cursive;
    font-size: 1.08em;
    letter-spacing: 0;
    margin: 0 0.12em;
    text-transform: none;
  }

  .swimdays-home-shop-all-products .featured-section__cta {
    color: #2e2b26;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: clamp(0.75rem, 0.8vw, 0.85rem);
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .swimdays-home-shop-all-products .featured-section__cta {
    border-bottom: 1px solid #2e2b26;
    padding-bottom: 2px;
  }

  .swimdays-home-shop-all-products .featured-section__cta:hover {
    opacity: 0.7;
  }

  .swimdays-home-shop-all-products .featured-section__footer {
    align-items: center;
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    margin-top: clamp(0.7rem, 1.4vw, 0.95rem);
  }

  .swimdays-home-shop-all-products .featured-nav-btn {
    appearance: none;
    background: transparent;
    border: 0;
    color: #2e2b26;
    cursor: pointer;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: clamp(0.75rem, 0.8vw, 0.85rem);
    letter-spacing: 0.05em;
    padding: 0;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .swimdays-home-shop-all-products .featured-nav-btn:hover,
  .swimdays-home-shop-all-products .featured-nav-btn:focus-visible {
    opacity: 0.7;
  }

  .swimdays-home-shop-all-products .featured-nav-separator {
    color: rgba(46, 43, 38, 0.5);
    font-family: "Swimdays Body", sans-serif;
    font-size: 0.9rem;
    line-height: 1;
  }

  .swimdays-home-shop-all-products .featured-scroller {
    -webkit-overflow-scrolling: touch;
    display: flex;
    gap: 2px;
    overflow-x: auto;
    padding-bottom: 0.3rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .swimdays-home-shop-all-products .featured-scroller::-webkit-scrollbar {
    display: none;
  }

  .swimdays-home-shop-all-products .featured-scroller .swimdays-product-card {
    flex: 0 0 calc(20% - 1.6px);
    scroll-snap-align: start;
  }

  .swimdays-home-shop-all-products .swimdays-product-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__link {
    color: #2e2b26;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__media-link {
    color: inherit;
    display: block;
    height: 100%;
    inset: 0;
    position: absolute;
    text-decoration: none;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__image-wrapper {
    aspect-ratio: 3 / 4;
    background-color: #fffdfa;
    flex: 0 0 auto;
    margin-bottom: 1rem;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
    width: 100%;
  }

  .swimdays-home-shop-all-products .swimdays-product-card:hover .swimdays-product-card__image {
    transform: scale(1.03);
  }

  .swimdays-home-shop-all-products .swimdays-product-card__badge {
    -webkit-backdrop-filter: blur(12px) saturate(135%);
    align-items: center;
    backdrop-filter: blur(12px) saturate(135%);
    background: rgba(28, 27, 26, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.62rem;
    justify-content: center;
    left: 0.75rem;
    letter-spacing: 0.11em;
    line-height: 1;
    min-height: 2rem;
    padding: 0.45rem 0.8rem;
    position: absolute;
    text-transform: uppercase;
    top: 0.75rem;
    white-space: nowrap;
    z-index: 2;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__badge--bestseller {
    background: #b1bd75;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__badge--new-arrival {
    background: #a84f77;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__badge--limited {
    background: rgba(28, 27, 26, 0.62);
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add {
    background: rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(28, 27, 26, 0.08);
    bottom: 0;
    color: #2e2b26;
    display: block;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 0.75rem;
    height: auto;
    left: 0;
    letter-spacing: 0.05em;
    min-height: 2.6rem;
    padding: 0;
    position: absolute;
    text-align: center;
    text-transform: uppercase;
    transform: translateY(0);
    transition: transform 0.3s ease;
    width: 100%;
    z-index: 3;
  }

  @media (hover: hover) {
    .swimdays-home-shop-all-products .swimdays-product-card__quick-add {
      transform: translateY(100%);
    }

    .swimdays-home-shop-all-products .swimdays-product-card:hover .swimdays-product-card__quick-add,
    .swimdays-home-shop-all-products .swimdays-product-card:focus-within .swimdays-product-card__quick-add {
      transform: translateY(0);
    }
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add {
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__product-form-component,
  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .shopify-product-form,
  .swimdays-home-shop-all-products .quick-add[data-quick-add-button='add'] add-to-cart-component {
    display: block;
    height: 100%;
    width: 100%;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__button {
    align-items: center;
    background: transparent;
    backdrop-filter: none;
    border: 0;
    border-radius: 0;
    bottom: 0;
    color: inherit;
    display: flex !important;
    height: 100%;
    justify-content: center;
    left: 0;
    min-height: 2.6rem;
    opacity: 1 !important;
    overflow: hidden;
    padding: 0.75rem;
    pointer-events: all;
    position: absolute;
    right: 0;
    scale: 1;
    top: 0;
    width: 100%;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__button:hover,
  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__button:active {
    scale: 1;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__button .add-to-cart-icon,
  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .quick-add__button .add-to-cart-text,
  .swimdays-home-shop-all-products .swimdays-product-card__quick-add .add-to-cart__added {
    opacity: 0;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__quick-add-label {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    letter-spacing: 0.05em;
    pointer-events: none;
    position: absolute;
    text-transform: uppercase;
    z-index: 2;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__info {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__title {
    font-family: "Swimdays Body", sans-serif;
    font-size: clamp(0.85rem, 0.9vw, 1rem);
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  .swimdays-home-shop-all-products .swimdays-product-card__price {
    font-family: "Swimdays Subhead", sans-serif;
    font-size: clamp(0.8rem, 0.85vw, 0.9rem);
    margin: 0;
    white-space: nowrap;
  }

  @media screen and (max-width: 1023px) {
    .swimdays-home-shop-all-products .featured-section__head,
    .swimdays-home-shop-all-products .featured-section__footer {
      padding-inline: var(--gutter-inline, 1rem);
    }

    .swimdays-home-shop-all-products .featured-scroller {
      padding-inline: var(--gutter-inline, 1rem);
      scroll-padding-inline: var(--gutter-inline, 1rem);
    }

    .swimdays-home-shop-all-products .featured-scroller .swimdays-product-card {
      flex: 0 0 clamp(280px, 42vw, 360px);
    }
  }

  @media screen and (max-width: 639px) {
    .swimdays-home-shop-all-products .featured-scroller .swimdays-product-card {
      flex: 0 0 clamp(252px, 82vw, 320px);
    }

    .swimdays-home-shop-all-products .featured-section__cta,
    .swimdays-home-shop-all-products .featured-nav-btn {
      font-size: 0.72rem;
    }
  }

{% endstylesheet %}

{% javascript %}
  (() => {
    const initSwimdaysHomeProducts = (root = document) => {
      const sections = root.querySelectorAll('[data-swimdays-home-shop-all-products]');

      sections.forEach((section) => {
        if (section.dataset.swimdaysProductsInit === 'true') return;
        section.dataset.swimdaysProductsInit = 'true';

        const scroller = section.querySelector('[data-featured-scroller]');
        const prevButton = section.querySelector('.featured-nav-btn.prev');
        const nextButton = section.querySelector('.featured-nav-btn.next');

        if (!scroller || !prevButton || !nextButton) return;

        const getScrollAmount = () => {
          const card = scroller.querySelector('.swimdays-product-card');
          return card ? card.offsetWidth + 2 : 0;
        };

        prevButton.addEventListener('click', () => {
          scroller.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });

        nextButton.addEventListener('click', () => {
          scroller.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initSwimdaysHomeProducts());
    } else {
      initSwimdaysHomeProducts();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initSwimdaysHomeProducts(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Swimdays products",
  "tag": "section",
  "class": "shopify-section--swimdays-home-shop-all-products",
  "limit": 1,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured first product",
      "info": "Optional. This product is pinned first, then skipped in the regular list to avoid duplicates."
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading prefix",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "all"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading suffix",
      "default": "Products"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "shop_now_label",
      "label": "Quick add label",
      "default": "Quick Add"
    }
  ],
  "presets": [
    {
      "name": "Swimdays shop all products"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
