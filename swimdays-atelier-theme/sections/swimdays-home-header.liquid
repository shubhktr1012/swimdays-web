{% render 'swimdays-home-fonts' %}
{% render 'swimdays-home-header' %}

<div class="swimdays-home-header-spacer" aria-hidden="true"></div>

{% stylesheet %}
  body {
    --swimdays-fixed-header-height: calc(2rem + clamp(60px, 7vw, 72px));
  }

  body.announcement-hidden {
    --swimdays-fixed-header-height: clamp(60px, 7vw, 72px);
  }

  .swimdays-home-header-spacer {
    height: 0;
    width: 100%;
    pointer-events: none;
  }

  body.announcement-hidden .swimdays-home-header-spacer {
    height: 0;
  }

  body:not(.swimdays-template-index) .swimdays-home-header-spacer {
    height: calc(2rem + clamp(60px, 7vw, 72px));
  }

  body:not(.swimdays-template-index).announcement-hidden .swimdays-home-header-spacer {
    height: clamp(60px, 7vw, 72px);
  }

  @media screen and (max-width: 749px) {
    .swimdays-home-header-spacer {
      height: 0;
    }

    body:not(.swimdays-template-index) .swimdays-home-header-spacer {
      height: calc(2rem + clamp(60px, 7vw, 72px));
    }

    body:not(.swimdays-template-index).announcement-hidden .swimdays-home-header-spacer {
      height: clamp(60px, 7vw, 72px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swimdays home header",
  "tag": "section",
  "class": "shopify-section--swimdays-home-header",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Swimdays home header"
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection", "product", "blog", "article", "search", "cart", "customers/login", "customers/register", "customers/account", "list-collections"]
  }
}
{% endschema %}
