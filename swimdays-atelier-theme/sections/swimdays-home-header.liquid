{% render 'swimdays-home-fonts' %}
{% render 'swimdays-home-header',
  primary_menu: section.settings.primary_menu,
  announcement_text_primary: section.settings.announcement_text_primary,
  announcement_text_secondary: section.settings.announcement_text_secondary,
  announcement_link_label: section.settings.announcement_link_label,
  announcement_link_url: section.settings.announcement_link_url
%}

<div class="swimdays-home-header-spacer" aria-hidden="true"></div>

{% stylesheet %}
  body {
    --swimdays-fixed-header-height: calc(2rem + clamp(60px, 7vw, 72px));
  }

  body.announcement-hidden {
    --swimdays-fixed-header-height: clamp(60px, 7vw, 72px);
  }

  .swimdays-home-header-spacer {
    height: 0;
    width: 100%;
    pointer-events: none;
  }

  body.announcement-hidden .swimdays-home-header-spacer {
    height: 0;
  }

  body:not(.swimdays-template-index) .swimdays-home-header-spacer {
    height: calc(2rem + clamp(60px, 7vw, 72px));
  }

  body:not(.swimdays-template-index).announcement-hidden .swimdays-home-header-spacer {
    height: clamp(60px, 7vw, 72px);
  }

  @media screen and (max-width: 749px) {
    .swimdays-home-header-spacer {
      height: 0;
    }

    body:not(.swimdays-template-index) .swimdays-home-header-spacer {
      height: calc(2rem + clamp(60px, 7vw, 72px));
    }

    body:not(.swimdays-template-index).announcement-hidden .swimdays-home-header-spacer {
      height: clamp(60px, 7vw, 72px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Swimdays home header",
  "tag": "section",
  "class": "shopify-section--swimdays-home-header",
  "limit": 1,
  "settings": [
    {
      "type": "link_list",
      "id": "primary_menu",
      "label": "Primary menu"
    },
    {
      "type": "text",
      "id": "announcement_text_primary",
      "label": "Announcement primary text",
      "default": "Free Worldwide Shipping"
    },
    {
      "type": "text",
      "id": "announcement_text_secondary",
      "label": "Announcement secondary text",
      "default": "On Orders Over $150"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Announcement link URL"
    }
  ],
  "presets": [
    {
      "name": "Swimdays home header"
    }
  ],
  "enabled_on": {
    "templates": ["index", "page", "collection", "product", "blog", "article", "search", "cart", "customers/login", "customers/register", "customers/account", "list-collections"]
  }
}
{% endschema %}
