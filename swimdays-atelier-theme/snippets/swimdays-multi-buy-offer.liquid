{%- doc -%}
  Whole-store Buy 2 / Buy 3 offer line for PDP and cart progress.
  Commerce is enforced by Shopify automatic discounts; this is messaging only.

  @param {string} [context] - 'pdp' | 'cart' (default: pdp)
{%- enddoc -%}

{% liquid
  assign offer_context = context | default: 'pdp'
  assign item_count = cart.item_count | default: 0
%}

{% if offer_context == 'cart' %}
  {% if item_count == 1 %}
    <p class="swimdays-multi-buy swimdays-multi-buy--cart" role="status">
      Add 1 more to save 15%
    </p>
  {% elsif item_count == 2 %}
    <p class="swimdays-multi-buy swimdays-multi-buy--cart" role="status">
      Add 1 more to save 20%
    </p>
  {% elsif item_count >= 3 %}
    <p class="swimdays-multi-buy swimdays-multi-buy--cart swimdays-multi-buy--active" role="status">
      You’re saving 20%
    </p>
  {% endif %}
{% else %}
  <div class="swimdays-multi-buy swimdays-multi-buy--pdp">
    <p class="swimdays-multi-buy__title">Buy 2, save 15%. Buy 3, save 20%.</p>
    <p class="swimdays-multi-buy__note">Cannot be combined with other discount codes.</p>
  </div>
{% endif %}

{% stylesheet %}
  .swimdays-multi-buy--pdp {
    width: 100%;
    text-align: center;
    margin: 0 0 1rem;
  }

  .swimdays-multi-buy__title {
    margin: 0;
    font-family: var(--font-body--family), system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: #34565b;
  }

  .swimdays-multi-buy__note {
    margin: 0.35rem 0 0;
    font-family: var(--font-body--family), system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: rgba(52, 86, 91, 0.72);
  }

  .swimdays-multi-buy--cart {
    margin: 0 0 0.85rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(52, 86, 91, 0.18);
    background: rgba(250, 246, 241, 0.9);
    font-family: var(--font-body--family), system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: #34565b;
    text-align: center;
  }

  .swimdays-multi-buy--cart.swimdays-multi-buy--active {
    border-color: rgba(168, 79, 119, 0.28);
    color: #a84f77;
  }
{% endstylesheet %}
