{% javascript %}
  (() => {
    const initSwimdaysHomeHeader = (root = document) => {
      const headerWrappers = root.querySelectorAll('.swimdays-home-header');

      headerWrappers.forEach((wrapper) => {
        const navbar = wrapper.querySelector('.swimdays-navbar');
        if (!navbar || navbar.dataset.swimdaysHeaderInit === 'true') return;

        navbar.dataset.swimdaysHeaderInit = 'true';

        const announcementTrigger = document.querySelector('#brand-statement');
        const menuToggle = wrapper.querySelector('.navbar-toggle');
        const menuClose = wrapper.querySelector('.mobile-menu-close');
        const mobileMenu = wrapper.querySelector('.mobile-menu');
        const mobileMenuLinks = wrapper.querySelectorAll('.mobile-menu a');
        const desktopViewport = window.matchMedia('(min-width: 960px)');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const announcementCarousel = wrapper.querySelector('[data-swimdays-announcement-carousel]');

        const setMenuState = (isOpen) => {
          navbar.classList.toggle('menu-open', isOpen);
          document.body.classList.toggle('nav-locked', isOpen);
          if (menuToggle) menuToggle.setAttribute('aria-expanded', String(isOpen));
          if (mobileMenu) {
            mobileMenu.setAttribute('aria-hidden', String(!isOpen));

            if (isOpen) {
              mobileMenu.removeAttribute('inert');
            } else {
              mobileMenu.setAttribute('inert', '');
            }
          }
        };

        const shouldHideAnnouncement = () => {
          if (announcementTrigger) {
            const triggerTop = announcementTrigger.getBoundingClientRect().top;
            const hideThreshold = window.innerHeight * 0.82;
            return triggerTop <= hideThreshold;
          }

          return window.scrollY > 72;
        };

        const applyScrollState = () => {
          navbar.classList.toggle('is-scrolled', window.scrollY > 20);
          document.body.classList.toggle('announcement-hidden', shouldHideAnnouncement());
        };

        const initAnnouncementCarousel = () => {
          if (!announcementCarousel || announcementCarousel.dataset.announcementInit === 'true') return;

          const slides = Array.from(announcementCarousel.querySelectorAll('[data-announcement-slide]'));
          if (slides.length < 2) return;

          announcementCarousel.dataset.announcementInit = 'true';

          let currentIndex = 0;
          let intervalId;

          const setSlide = (nextIndex) => {
            currentIndex = ((nextIndex % slides.length) + slides.length) % slides.length;

            slides.forEach((slide, index) => {
              const isActive = index === currentIndex;
              slide.classList.toggle('is-active', isActive);
              slide.setAttribute('aria-hidden', String(!isActive));
              slide.toggleAttribute('inert', !isActive);

              if (isActive) {
                announcementCarousel.classList.toggle('is-launch', slide.dataset.announcementVariant === 'launch');
              }
            });
          };

          const stopCarousel = () => {
            window.clearInterval(intervalId);
            intervalId = undefined;
          };

          const startCarousel = () => {
            stopCarousel();
            if (reducedMotion.matches || document.hidden) return;

            intervalId = window.setInterval(() => {
              setSlide(currentIndex + 1);
            }, 9000);
          };

          announcementCarousel.addEventListener('mouseenter', stopCarousel);
          announcementCarousel.addEventListener('mouseleave', startCarousel);
          announcementCarousel.addEventListener('focusin', stopCarousel);
          announcementCarousel.addEventListener('focusout', startCarousel);
          reducedMotion.addEventListener('change', startCarousel);
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
              stopCarousel();
            } else {
              startCarousel();
            }
          });

          setSlide(0);
          startCarousel();
        };

        menuToggle?.addEventListener('click', () => setMenuState(true));
        menuClose?.addEventListener('click', () => setMenuState(false));
        mobileMenu?.addEventListener('click', (event) => {
          if (event.target === mobileMenu) setMenuState(false);
        });
        mobileMenuLinks.forEach((link) => link.addEventListener('click', () => setMenuState(false)));
        desktopViewport.addEventListener('change', (event) => {
          if (event.matches) setMenuState(false);
        });

        window.addEventListener('scroll', applyScrollState, { passive: true });
        window.addEventListener('resize', applyScrollState);
        applyScrollState();
        initAnnouncementCarousel();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initSwimdaysHomeHeader());
    } else {
      initSwimdaysHomeHeader();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initSwimdaysHomeHeader(event.target);
    });
  })();
{% endjavascript %}
