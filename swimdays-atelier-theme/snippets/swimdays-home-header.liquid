{% doc %}
  Renders the Swimdays global announcement bar and custom navbar.

  Used by the active Swimdays header implementation rendered globally from layout/theme.liquid.

  @param {object} [primary_menu] - Menu used for the primary navigation.
  @param {boolean} [announcement_enabled] - Whether to show the shipping announcement slide.
  @param {string} [announcement_text_primary] - Primary announcement text.
  @param {string} [announcement_text_secondary] - Secondary announcement text.
  @param {string} [announcement_link_label] - Announcement CTA label.
  @param {string} [announcement_link_url] - Announcement CTA URL.
  @param {boolean} [launch_announcement_enabled] - Whether to show the launch announcement slide.
  @param {boolean} [launch_announcement_first] - Whether to show the launch announcement before shipping.
  @param {string} [launch_announcement_label] - Launch announcement label.
  @param {string} [launch_announcement_text] - Launch announcement text.
  @param {string} [launch_announcement_link_label] - Launch announcement CTA label.
  @param {string} [launch_announcement_link_url] - Launch announcement CTA URL.
  @param {string} [launch_announcement_background] - Launch announcement background color.
{% enddoc %}

{% liquid
  assign primary_menu = primary_menu
  if primary_menu == blank
    assign primary_menu = linklists['main-menu']
  endif
  if announcement_enabled == nil
    assign announcement_enabled = true
  endif
  assign announcement_text_primary = announcement_text_primary | default: 'Free India-Wide Shipping'
  assign announcement_text_secondary = announcement_text_secondary | default: ''
  assign announcement_link_label = announcement_link_label | default: 'Shop now'
  assign announcement_link_url = announcement_link_url | default: routes.all_products_collection_url
  if launch_announcement_enabled == nil
    assign launch_announcement_enabled = true
  endif
  if launch_announcement_first == nil
    assign launch_announcement_first = true
  endif
  assign launch_announcement_label = launch_announcement_label | default: 'New Arrival'
  assign launch_announcement_text = launch_announcement_text | default: 'Sea Spurrey in Pink'
  assign launch_announcement_link_label = launch_announcement_link_label | default: 'Shop Now'
  assign launch_announcement_link_url = launch_announcement_link_url | default: routes.all_products_collection_url
  assign launch_announcement_background = launch_announcement_background | default: '#CFA7BB'
  assign first_announcement_variant = 'shipping'
  if launch_announcement_enabled and launch_announcement_first
    assign first_announcement_variant = 'launch'
  elsif announcement_enabled
    assign first_announcement_variant = 'shipping'
  elsif launch_announcement_enabled
    assign first_announcement_variant = 'launch'
  endif
  if launch_announcement_first
    assign announcement_slide_order = 'launch,shipping' | split: ','
  else
    assign announcement_slide_order = 'shipping,launch' | split: ','
  endif
%}

<div class="swimdays-home-header">
  <div
    class="announcement{% if first_announcement_variant == 'launch' %} is-launch{% endif %}"
    data-swimdays-announcement-carousel
  >
    <div class="announcement__inner">
      <div class="announcement__track" aria-live="polite">
        {% liquid
          assign rendered_announcement_slides = 0
        %}

        {% for announcement_slide_type in announcement_slide_order %}
          {% if announcement_slide_type == 'launch' and launch_announcement_enabled %}
            <p
              class="announcement__text announcement__slide{% if rendered_announcement_slides == 0 %} is-active{% endif %}"
              data-announcement-slide
              data-announcement-variant="launch"
              {% unless rendered_announcement_slides == 0 %}
                aria-hidden="true"
                inert
              {% endunless %}
            >
              <span>{{ launch_announcement_label }}</span>
              <span class="announcement__dot" aria-hidden="true"></span>
              <span>{{ launch_announcement_text }}</span>
              <span class="announcement__dot" aria-hidden="true"></span>
              <a class="announcement__link" href="{{ launch_announcement_link_url }}">
                {{ launch_announcement_link_label }}
                <span class="icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 9.5L9.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M4 2.5H9.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            </p>

            {% liquid
              assign rendered_announcement_slides = rendered_announcement_slides | plus: 1
            %}
          {% endif %}

          {% if announcement_slide_type == 'shipping' and announcement_enabled %}
            <p
              class="announcement__text announcement__slide{% if rendered_announcement_slides == 0 %} is-active{% endif %}"
              data-announcement-slide
              data-announcement-variant="shipping"
              {% unless rendered_announcement_slides == 0 %}
                aria-hidden="true"
                inert
              {% endunless %}
            >
              <span>{{ announcement_text_primary }}</span>
              <span class="announcement__dot" aria-hidden="true"></span>
              {% if announcement_text_secondary != blank %}
                <span data-hide-mobile="true">{{ announcement_text_secondary }}</span>
                <span class="announcement__dot" aria-hidden="true"></span>
              {% endif %}
              <a class="announcement__link" href="{{ announcement_link_url }}">
                {{ announcement_link_label }}
                <span class="icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 9.5L9.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M4 2.5H9.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            </p>

            {% liquid
              assign rendered_announcement_slides = rendered_announcement_slides | plus: 1
            %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <header class="swimdays-navbar" data-swimdays-home-header>
    {% if request.page_type == 'index' %}
      <h1 class="visually-hidden">Swimdays - Slow-Made Modest Artisanal Swimwear</h1>
    {% endif %}
    <div class="navbar-bg-overflow">
      <span class="navbar-flower-img top-left" aria-hidden="true">
        {{ 'flower.svg' | inline_asset_content }}
      </span>
      <span class="navbar-flower-img bottom-right" aria-hidden="true">
        {{ 'flower.svg' | inline_asset_content }}
      </span>
    </div>

    <div class="navbar-inner">
      <div class="navbar-left">
        <div class="navbar-mobile-actions">
          <button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="swimdays-mobile-menu" aria-label="Open menu">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 7H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M4 12H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M9 17H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span class="visually-hidden">Open menu</span>
          </button>

          <search-button class="search-action">
            <button
              on:click="#search-modal/showDialog"
              class="navbar-icon-button"
              aria-label="Search"
              aria-haspopup="dialog"
              type="button"
            >
              <span class="navbar-icon" aria-hidden="true">
                {{ 'icon-search.svg' | inline_asset_content }}
              </span>
              <span class="visually-hidden">Search</span>
            </button>
          </search-button>
        </div>

        <nav class="navbar-primary-nav" aria-label="Primary">
          <ul class="navbar-links">
            {% if primary_menu != blank and primary_menu.links.size > 0 %}
              {% for link in primary_menu.links %}
                <li{% if link.links != blank and link.links.size > 0 %} class="has-dropdown"{% endif %}>
                  <a href="{{ link.url }}">
                    <span>{{ link.title }}</span>
                    {% if link.links != blank and link.links.size > 0 %}
                      <svg class="nav-dropdown-caret" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </a>

                  {% if link.links != blank and link.links.size > 0 %}
                    <ul class="dropdown-menu">
                      {% for child_link in link.links %}
                        <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.root_url }}">Home</a></li>
              <li class="has-dropdown">
                <a href="{{ routes.all_products_collection_url }}">
                  <span>Collections</span>
                  <svg class="nav-dropdown-caret" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <ul class="dropdown-menu">
                  <li><a href="{{ collections['moss'].url | default: routes.all_products_collection_url }}">Moss</a></li>
                  <li><a href="{{ collections['cove'].url | default: routes.all_products_collection_url }}">Cove</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">View All</a></li>
                </ul>
              </li>
            {% endif %}
          </ul>
        </nav>
      </div>

      <div class="navbar-center">
        <a href="{{ routes.root_url }}" aria-label="Swimdays home">
          {% if settings.logo != blank and settings.logo.width != blank %}
            {{ settings.logo | image_url: width: 260 | image_tag: class: 'navbar-logo', alt: shop.name }}
          {% else %}
            <span class="navbar-wordmark">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <div class="navbar-right">
        <search-button class="search-action desktop-only">
          <button
            on:click="#search-modal/showDialog"
            class="navbar-icon-button"
            aria-label="Search"
            aria-haspopup="dialog"
            type="button"
          >
            <span class="navbar-icon" aria-hidden="true">
              {{ 'icon-search.svg' | inline_asset_content }}
            </span>
            <span class="visually-hidden">Search</span>
          </button>
        </search-button>

        <a
          class="navbar-icon-button"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="Account"
        >
          <span class="navbar-icon" aria-hidden="true">
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
          <span class="visually-hidden">Account</span>
        </a>

        <a class="badge-wrapper" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">
          <span class="navbar-icon navbar-icon--cart" aria-hidden="true">
            {{ 'icon-cart.svg' | inline_asset_content }}
            {% if cart.item_count > 0 %}
              <span class="icon-badge">{{ cart.item_count }}</span>
            {% endif %}
          </span>
          <span class="visually-hidden">Cart</span>
        </a>
      </div>

      <div class="mobile-menu" id="swimdays-mobile-menu" aria-hidden="true" inert>
        <div class="mobile-menu-inner">
          <div class="mobile-menu-header">
            <p>Menu</p>
            <button class="mobile-menu-close" type="button" aria-label="Close menu">
              <span aria-hidden="true">&times;</span>
              <span class="visually-hidden">Close menu</span>
            </button>
          </div>

          <ul class="mobile-menu-list">
            {% if primary_menu != blank and primary_menu.links.size > 0 %}
              {% for link in primary_menu.links %}
                <li>
                  {% if link.links != blank and link.links.size > 0 %}
                    <details{% if forloop.first %} open{% endif %}>
                      <summary>{{ link.title }}</summary>
                      <ul class="mobile-submenu">
                        {% for child_link in link.links %}
                          <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% else %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.root_url }}">Home</a></li>
              <li>
                <details open>
                  <summary>Collections</summary>
                  <ul class="mobile-submenu">
                    <li><a href="{{ collections['moss'].url | default: routes.all_products_collection_url }}">Moss</a></li>
                    <li><a href="{{ collections['cove'].url | default: routes.all_products_collection_url }}">Cove</a></li>
                    <li><a href="{{ routes.all_products_collection_url }}">View All</a></li>
                  </ul>
                </details>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </header>
</div>

{% style %}
  .swimdays-home-header {
    --navbar-content: #ffffff;
    --bg: var(--color-background, #f7f6f2);
    --surface: #fffdfa;
    --line: rgba(17, 17, 17, 0.1);
    --accent-rose: #a84f77;
    --launch-pink: {{ launch_announcement_background }};
    --container: min(100% - 32px, 1420px);
    --space-3: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
    --navbar-height: clamp(60px, 7vw, 72px);
    --navbar-height-scrolled: clamp(52px, 6vw, 58px);
    --announcement-height: 2rem;
    --navbar-safe-zone: 0px;
    --navbar-flower-edge-offset: -18px;
    position: relative;
    z-index: 40;
  }

  body.announcement-hidden .swimdays-home-header,
  body:not(.swimdays-template-index) .swimdays-home-header {
    --navbar-content: #111111;
  }

  .swimdays-home-header .announcement {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 30;
    height: var(--announcement-height);
    --announcement-bg: var(--accent-rose);
    --announcement-fg: #ffffff;
    --announcement-border: rgba(225, 236, 234, 0.24);
    --announcement-link-border: rgba(255, 255, 255, 0.35);
    --announcement-link-border-hover: rgba(255, 255, 255, 0.6);
    --announcement-dot: rgba(255, 255, 255, 0.55);
    background: var(--announcement-bg);
    color: var(--announcement-fg);
    border-bottom: 1px solid var(--announcement-border);
    display: grid;
    place-items: center;
    padding: 0 var(--space-3);
    transition:
      background-color 0.45s ease,
      color 0.3s ease,
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.28s ease;
  }

  .swimdays-home-header .announcement.is-launch {
    --announcement-bg: var(--launch-pink);
    --announcement-fg: #21191d;
    --announcement-border: rgba(33, 25, 29, 0.12);
    --announcement-link-border: rgba(33, 25, 29, 0.3);
    --announcement-link-border-hover: rgba(33, 25, 29, 0.55);
    --announcement-dot: rgba(33, 25, 29, 0.45);
  }

  .swimdays-home-header .announcement__inner {
    width: var(--container);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swimdays-home-header .announcement__track {
    width: 100%;
    min-height: var(--announcement-height);
    display: grid;
    place-items: center;
  }

  .swimdays-home-header .announcement__text {
    grid-area: 1 / 1;
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    color: var(--announcement-fg);
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(0.58rem, 0.55rem + 0.15vw, 0.68rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .swimdays-home-header .announcement__slide {
    opacity: 0;
    visibility: hidden;
    transform: translateY(3px);
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
  }

  .swimdays-home-header .announcement__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .swimdays-home-header .announcement__dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: var(--announcement-dot);
    flex: 0 0 auto;
  }

  .swimdays-home-header .announcement__link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--announcement-fg);
    text-decoration: none;
    border-bottom: 1px solid var(--announcement-link-border);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .swimdays-home-header .announcement__link:hover {
    border-color: var(--announcement-link-border-hover);
  }

  .swimdays-home-header .announcement__slide[aria-hidden='true'] .announcement__link {
    pointer-events: none;
  }

  body.announcement-hidden .swimdays-home-header .announcement {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  body.nav-locked {
    overflow: hidden;
  }

  .swimdays-home-header .swimdays-navbar {
    position: fixed;
    top: var(--announcement-height);
    left: 0;
    width: 100%;
    height: var(--navbar-height);
    background: transparent;
    color: var(--navbar-content);
    border-bottom: 1px solid transparent;
    z-index: 29;
    container-type: inline-size;
    container-name: navbar;
    transition:
      top 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.35s ease,
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  body.announcement-hidden .swimdays-home-header .swimdays-navbar {
    top: 0;
    background: var(--bg);
    border-bottom-color: rgba(168, 79, 119, 0.5);
  }

  body:not(.swimdays-template-index) .swimdays-home-header .swimdays-navbar {
    background: var(--bg);
    border-bottom-color: rgba(168, 79, 119, 0.5);
  }

  .swimdays-home-header .swimdays-navbar.is-scrolled {
    height: var(--navbar-height-scrolled);
  }

  .swimdays-home-header .navbar-bg-overflow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .swimdays-home-header .navbar-flower-img {
    position: absolute;
    width: 64px;
    height: 64px;
    display: inline-flex;
    color: #a84f77;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .swimdays-home-header .navbar-flower-img svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: brightness(0) saturate(100%) invert(42%) sepia(21%) saturate(1514%) hue-rotate(294deg) brightness(86%) contrast(85%);
  }

  .swimdays-home-header .navbar-flower-img.top-left {
    top: -18px;
    left: var(--navbar-flower-edge-offset);
  }

  .swimdays-home-header .navbar-flower-img.bottom-right {
    bottom: -18px;
    right: var(--navbar-flower-edge-offset);
  }

  body.announcement-hidden .swimdays-home-header .navbar-flower-img {
    opacity: 1;
  }

  body:not(.swimdays-template-index) .swimdays-home-header .navbar-flower-img {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    body.announcement-hidden .swimdays-home-header .navbar-flower-img {
      opacity: 0.5;
    }

    body:not(.swimdays-template-index) .swimdays-home-header .navbar-flower-img {
      opacity: 0.5;
    }
  }

  .swimdays-home-header .navbar-inner {
    width: var(--container);
    margin: 0 auto;
    box-sizing: border-box;
    padding-inline: var(--navbar-safe-zone);
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    position: relative;
    gap: 12px;
  }

  .swimdays-home-header .navbar-left,
  .swimdays-home-header .navbar-right {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .swimdays-home-header .navbar-right {
    justify-content: flex-end;
    margin-left: auto;
  }

  .swimdays-home-header .navbar-mobile-actions {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .swimdays-home-header .navbar-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    max-width: calc(100% - 210px);
    overflow: visible;
  }

  .swimdays-home-header .navbar-center a {
    display: inline-flex;
    position: relative;
    z-index: 1;
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }

  .swimdays-home-header .navbar-logo {
    height: clamp(24px, 5vw, 30px);
    width: auto;
    display: block;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: filter 0.28s ease;
  }

  body.announcement-hidden .swimdays-home-header .navbar-logo,
  body:not(.swimdays-template-index) .swimdays-home-header .navbar-logo {
    filter: none;
  }

  .swimdays-home-header .navbar-wordmark {
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: 1.25rem;
    letter-spacing: 0.03em;
  }

  .swimdays-home-header .navbar-primary-nav {
    min-width: 0;
    display: none;
  }

  .swimdays-home-header .navbar-links {
    display: flex;
    gap: clamp(24px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .swimdays-home-header .navbar-links > li {
    position: relative;
  }

  .swimdays-home-header .navbar-links > li > a,
  .swimdays-home-header .mobile-menu a,
  .swimdays-home-header .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Swimdays Subhead", sans-serif;
    text-decoration: none;
    color: var(--navbar-content);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }

  .swimdays-home-header .mobile-menu a,
  .swimdays-home-header .mobile-menu summary {
    color: #111111;
  }

  .swimdays-home-header .navbar-links > li > a {
    position: relative;
    padding-bottom: 4px;
    transition: color 0.24s ease;
  }

  .swimdays-home-header .navbar-links > li > a::after {
    content: "";
    position: absolute;
    width: 0;
    height: 1px;
    left: 0;
    bottom: 0;
    background: currentColor;
    transition: width 0.24s ease;
  }

  @media (hover: hover) {
    .swimdays-home-header .navbar-links > li > a:hover::after {
      width: 100%;
    }
  }

  .swimdays-home-header .has-dropdown {
    padding-bottom: 18px;
    margin-bottom: -18px;
  }

  .swimdays-home-header .nav-dropdown-caret {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
  }

  .swimdays-home-header .dropdown-menu {
    position: absolute;
    top: 100%;
