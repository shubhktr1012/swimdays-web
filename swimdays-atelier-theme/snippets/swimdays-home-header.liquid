{% doc %}
  Renders the Swimdays homepage announcement bar and custom navbar.

  Intended for the custom Swimdays homepage implementation, not the global theme header.

  @param {object} [primary_menu] - Menu used for the primary navigation.
  @param {string} [announcement_text_primary] - Primary announcement text.
  @param {string} [announcement_text_secondary] - Secondary announcement text.
  @param {string} [announcement_link_label] - Announcement CTA label.
  @param {string} [announcement_link_url] - Announcement CTA URL.
{% enddoc %}

{% liquid
  assign primary_menu = primary_menu
  if primary_menu == blank
    assign primary_menu = linklists['main-menu']
  endif
  assign announcement_text_primary = announcement_text_primary | default: 'Free Worldwide Shipping'
  assign announcement_text_secondary = announcement_text_secondary | default: 'On Orders Over $150'
  assign announcement_link_label = announcement_link_label | default: 'Shop now'
  assign announcement_link_url = announcement_link_url | default: routes.all_products_collection_url
%}

<div class="swimdays-home-header">
  <div class="announcement">
    <div class="announcement__inner">
      <p class="announcement__text">
        <span>{{ announcement_text_primary }}</span>
        <span class="announcement__dot" aria-hidden="true"></span>
        <span data-hide-mobile="true">{{ announcement_text_secondary }}</span>
        <a class="announcement__link" href="{{ announcement_link_url }}">
          {{ announcement_link_label }}
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.5 9.5L9.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M4 2.5H9.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </p>
    </div>
  </div>

  <header class="swimdays-navbar" data-swimdays-home-header>
    <div class="navbar-bg-overflow">
      <span class="navbar-flower-img top-left" aria-hidden="true">
        {{ 'flower.svg' | inline_asset_content }}
      </span>
      <span class="navbar-flower-img bottom-right" aria-hidden="true">
        {{ 'flower.svg' | inline_asset_content }}
      </span>
    </div>

    <div class="navbar-inner">
      <div class="navbar-left">
        <div class="navbar-mobile-actions">
          <button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="swimdays-mobile-menu" aria-label="Open menu">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 7H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M4 12H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M9 17H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>

          <search-button class="search-action">
            <button
              on:click="#search-modal/showDialog"
              class="navbar-icon-button"
              aria-label="Search"
              aria-haspopup="dialog"
              type="button"
            >
              <span class="navbar-icon" aria-hidden="true">
                {{ 'icon-search.svg' | inline_asset_content }}
              </span>
            </button>
          </search-button>
        </div>

        <nav class="navbar-primary-nav" aria-label="Primary">
          <ul class="navbar-links">
            {% if primary_menu != blank and primary_menu.links.size > 0 %}
              {% for link in primary_menu.links %}
                <li{% if link.links != blank and link.links.size > 0 %} class="has-dropdown"{% endif %}>
                  <a href="{{ link.url }}">
                    <span>{{ link.title }}</span>
                    {% if link.links != blank and link.links.size > 0 %}
                      <svg class="nav-dropdown-caret" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </a>

                  {% if link.links != blank and link.links.size > 0 %}
                    <ul class="dropdown-menu">
                      {% for child_link in link.links %}
                        <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.root_url }}">Home</a></li>
              <li class="has-dropdown">
                <a href="{{ routes.all_products_collection_url }}">
                  <span>Collections</span>
                  <svg class="nav-dropdown-caret" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <ul class="dropdown-menu">
                  <li><a href="{{ collections['moss'].url | default: routes.all_products_collection_url }}">Moss</a></li>
                  <li><a href="{{ collections['cove'].url | default: routes.all_products_collection_url }}">Cove</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">View All</a></li>
                </ul>
              </li>
            {% endif %}
          </ul>
        </nav>
      </div>

      <div class="navbar-center">
        <a href="{{ routes.root_url }}" aria-label="Swimdays home">
          {% if settings.logo != blank %}
            {{ settings.logo | image_url: width: 260 | image_tag: class: 'navbar-logo', alt: shop.name }}
          {% else %}
            <span class="navbar-wordmark">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <div class="navbar-right">
        <search-button class="search-action desktop-only">
          <button
            on:click="#search-modal/showDialog"
            class="navbar-icon-button"
            aria-label="Search"
            aria-haspopup="dialog"
            type="button"
          >
            <span class="navbar-icon" aria-hidden="true">
              {{ 'icon-search.svg' | inline_asset_content }}
            </span>
          </button>
        </search-button>

        <a
          class="navbar-icon-button"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="Account"
        >
          <span class="navbar-icon" aria-hidden="true">
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
        </a>

        <a class="badge-wrapper" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">
          <span class="navbar-icon" aria-hidden="true">
            {{ 'icon-cart.svg' | inline_asset_content }}
          </span>
          {% if cart.item_count > 0 %}
            <span class="icon-badge">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>

      <div class="mobile-menu" id="swimdays-mobile-menu" aria-hidden="true">
        <div class="mobile-menu-inner">
          <div class="mobile-menu-header">
            <p>Menu</p>
            <button class="mobile-menu-close" type="button" aria-label="Close menu">&times;</button>
          </div>

          <ul class="mobile-menu-list">
            {% if primary_menu != blank and primary_menu.links.size > 0 %}
              {% for link in primary_menu.links %}
                <li>
                  {% if link.links != blank and link.links.size > 0 %}
                    <details{% if forloop.first %} open{% endif %}>
                      <summary>{{ link.title }}</summary>
                      <ul class="mobile-submenu">
                        {% for child_link in link.links %}
                          <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% else %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.root_url }}">Home</a></li>
              <li>
                <details open>
                  <summary>Collections</summary>
                  <ul class="mobile-submenu">
                    <li><a href="{{ collections['moss'].url | default: routes.all_products_collection_url }}">Moss</a></li>
                    <li><a href="{{ collections['cove'].url | default: routes.all_products_collection_url }}">Cove</a></li>
                    <li><a href="{{ routes.all_products_collection_url }}">View All</a></li>
                  </ul>
                </details>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </header>
</div>

{% style %}
  .swimdays-home-header {
    --navbar-content: #111111;
    --bg: var(--color-background, #f7f6f2);
    --surface: #fffdfa;
    --line: rgba(17, 17, 17, 0.1);
    --accent-rose: #a84f77;
    --container: min(100% - 32px, 1420px);
    --space-3: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
    --navbar-height: clamp(60px, 7vw, 72px);
    --navbar-height-scrolled: clamp(52px, 6vw, 58px);
    --announcement-height: 2rem;
    position: relative;
    z-index: 40;
  }

  .swimdays-home-header .announcement {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 30;
    height: var(--announcement-height);
    background: var(--accent-rose);
    border-bottom: 1px solid rgba(225, 236, 234, 0.24);
    display: grid;
    place-items: center;
    padding: 0 var(--space-3);
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
  }

  .swimdays-home-header .announcement__inner {
    width: var(--container);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swimdays-home-header .announcement__text {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    color: #fff;
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(0.58rem, 0.55rem + 0.15vw, 0.68rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .swimdays-home-header .announcement__dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    flex: 0 0 auto;
  }

  .swimdays-home-header .announcement__link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .swimdays-home-header .announcement__link:hover {
    color: rgba(255, 255, 255, 0.82);
    border-color: rgba(255, 255, 255, 0.6);
  }

  body.announcement-hidden .swimdays-home-header .announcement {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  body.nav-locked {
    overflow: hidden;
  }

  .swimdays-home-header .swimdays-navbar {
    position: fixed;
    top: var(--announcement-height);
    left: 0;
    width: 100%;
    height: var(--navbar-height);
    background: transparent;
    color: var(--navbar-content);
    border-bottom: 1px solid transparent;
    z-index: 29;
    container-type: inline-size;
    container-name: navbar;
    transition:
      top 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.35s ease,
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  body.announcement-hidden .swimdays-home-header .swimdays-navbar {
    top: 0;
    background: var(--bg);
    border-bottom-color: rgba(168, 79, 119, 0.5);
  }

  body:not(.swimdays-template-index) .swimdays-home-header .swimdays-navbar {
    background: var(--bg);
    border-bottom-color: rgba(168, 79, 119, 0.5);
  }

  .swimdays-home-header .swimdays-navbar.is-scrolled {
    height: var(--navbar-height-scrolled);
  }

  .swimdays-home-header .navbar-bg-overflow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .swimdays-home-header .navbar-flower-img {
    position: absolute;
    width: 64px;
    height: 64px;
    display: inline-flex;
    color: #a84f77;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .swimdays-home-header .navbar-flower-img svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: brightness(0) saturate(100%) invert(42%) sepia(21%) saturate(1514%) hue-rotate(294deg) brightness(86%) contrast(85%);
  }

  .swimdays-home-header .navbar-flower-img.top-left {
    top: -18px;
    left: -18px;
  }

  .swimdays-home-header .navbar-flower-img.bottom-right {
    bottom: -18px;
    right: -18px;
  }

  body.announcement-hidden .swimdays-home-header .navbar-flower-img {
    opacity: 1;
  }

  body:not(.swimdays-template-index) .swimdays-home-header .navbar-flower-img {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    body.announcement-hidden .swimdays-home-header .navbar-flower-img {
      opacity: 0.5;
    }

    body:not(.swimdays-template-index) .swimdays-home-header .navbar-flower-img {
      opacity: 0.5;
    }
  }

  .swimdays-home-header .navbar-inner {
    width: var(--container);
    margin: 0 auto;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    position: relative;
    gap: 12px;
  }

  .swimdays-home-header .navbar-left,
  .swimdays-home-header .navbar-right {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .swimdays-home-header .navbar-right {
    justify-content: flex-end;
    margin-left: auto;
  }

  .swimdays-home-header .navbar-mobile-actions {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .swimdays-home-header .navbar-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    max-width: calc(100% - 210px);
    overflow: visible;
  }

  .swimdays-home-header .navbar-center a {
    display: inline-flex;
    position: relative;
    z-index: 1;
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }

  .swimdays-home-header .navbar-logo {
    height: clamp(24px, 5vw, 30px);
    width: auto;
    display: block;
    object-fit: contain;
  }

  .swimdays-home-header .navbar-wordmark {
    font-family: "Swimdays Heading", Georgia, serif;
    font-size: 1.25rem;
    letter-spacing: 0.03em;
  }

  .swimdays-home-header .navbar-primary-nav {
    min-width: 0;
    display: none;
  }

  .swimdays-home-header .navbar-links {
    display: flex;
    gap: clamp(24px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .swimdays-home-header .navbar-links > li {
    position: relative;
  }

  .swimdays-home-header .navbar-links > li > a,
  .swimdays-home-header .mobile-menu a,
  .swimdays-home-header .mobile-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Swimdays Subhead", sans-serif;
    text-decoration: none;
    color: var(--navbar-content);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }

  .swimdays-home-header .navbar-links > li > a {
    position: relative;
    padding-bottom: 4px;
    transition: color 0.24s ease;
  }

  .swimdays-home-header .navbar-links > li > a::after {
    content: "";
    position: absolute;
    width: 0;
    height: 1px;
    left: 0;
    bottom: 0;
    background: currentColor;
    transition: width 0.24s ease;
  }

  @media (hover: hover) {
    .swimdays-home-header .navbar-links > li > a:hover::after {
      width: 100%;
    }
  }

  .swimdays-home-header .has-dropdown {
    padding-bottom: 18px;
    margin-bottom: -18px;
  }

  .swimdays-home-header .nav-dropdown-caret {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
  }

  .swimdays-home-header .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    list-style: none;
    margin: 0;
    padding: 14px 18px;
    min-width: 170px;
    display: grid;
    gap: 12px;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 10px;
    background: #fffdfa;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  }

  @media (hover: hover) {
    .swimdays-home-header .has-dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  .swimdays-home-header .dropdown-menu a {
    text-transform: none;
    letter-spacing: 0.2px;
    font-size: 13px;
    color: var(--navbar-content);
    font-family: "Swimdays Body", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .swimdays-home-header .navbar-icon-button,
  .swimdays-home-header .navbar-toggle,
  .swimdays-home-header .badge-wrapper,
  .swimdays-home-header .mobile-menu-close {
    border: 0;
    background: transparent;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    appearance: none;
    color: var(--navbar-content);
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
  }

  .swimdays-home-header .navbar-toggle {
    width: 24px;
    height: 24px;
  }

  .swimdays-home-header .navbar-toggle svg,
  .swimdays-home-header .navbar-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    stroke: currentColor;
  }

  .swimdays-home-header .navbar-icon {
    width: 21px;
    height: 21px;
    display: block;
    flex: 0 0 auto;
  }

  .swimdays-home-header .badge-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .swimdays-home-header .icon-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    border: 1px solid currentColor;
    color: currentColor;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 10px;
    font-weight: 600;
    height: 16px;
    min-width: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    padding: 0 4px;
    background: transparent;
  }

  .swimdays-home-header .desktop-only {
    display: none;
  }

  .swimdays-home-header .mobile-menu {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: flex-start;
    padding: 0;
    background: rgba(12, 17, 24, 0.24);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }

  .swimdays-home-header .swimdays-navbar.menu-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .swimdays-home-header .mobile-menu-inner {
    width: min(86vw, 380px);
    max-width: 100%;
    height: 100dvh;
    padding: calc(var(--navbar-height) + 20px) 24px 32px;
    border-right: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 0 28px 28px 0;
    background: linear-gradient(180deg, rgba(247, 246, 242, 0.98) 0%, rgba(255, 255, 255, 0.96) 100%);
    box-shadow: 18px 0 64px rgba(17, 17, 17, 0.14);
    transform: translateX(calc(-100% - 24px));
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    overflow-y: auto;
  }

  .swimdays-home-header .swimdays-navbar.menu-open .mobile-menu-inner {
    transform: translateX(0);
  }

  .swimdays-home-header .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .swimdays-home-header .mobile-menu-header p {
    margin: 0;
    font-family: "Swimdays Subhead", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--navbar-content);
  }

  .swimdays-home-header .mobile-menu-close {
    width: 28px;
    height: 28px;
    font-size: 28px;
    line-height: 1;
    color: var(--navbar-content);
  }

  .swimdays-home-header .mobile-menu-list,
  .swimdays-home-header .mobile-submenu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .swimdays-home-header .mobile-menu-list {
    display: grid;
    gap: 18px;
  }

  .swimdays-home-header .mobile-menu-list > li {
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
    padding-bottom: 18px;
  }

  .swimdays-home-header .mobile-menu summary {
    list-style: none;
    cursor: pointer;
  }

  .swimdays-home-header .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .swimdays-home-header .mobile-submenu {
    display: grid;
    gap: 12px;
    padding-left: 4px;
    margin-top: 14px;
  }

  .swimdays-home-header .mobile-submenu a {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--navbar-content);
  }

  @container navbar (min-width: 960px) {
    .swimdays-home-header .navbar-inner {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 24px;
    }

    .swimdays-home-header .navbar-center {
      position: relative;
      left: auto;
      transform: none;
      max-width: none;
    }

    .swimdays-home-header .navbar-mobile-actions,
    .swimdays-home-header .mobile-menu {
      display: none;
    }

    .swimdays-home-header .navbar-primary-nav {
      display: block;
    }

    .swimdays-home-header .desktop-only {
      display: inline-flex;
    }
  }
{% endstyle %}

{% javascript %}
  (() => {
    const initSwimdaysHomeHeader = (root = document) => {
      const headerWrappers = root.querySelectorAll('.swimdays-home-header');

      headerWrappers.forEach((wrapper) => {
        const navbar = wrapper.querySelector('.swimdays-navbar');
        if (!navbar || navbar.dataset.swimdaysHeaderInit === 'true') return;

        navbar.dataset.swimdaysHeaderInit = 'true';

        const announcementTrigger = document.querySelector('#brand-statement');
        const menuToggle = wrapper.querySelector('.navbar-toggle');
        const menuClose = wrapper.querySelector('.mobile-menu-close');
        const mobileMenu = wrapper.querySelector('.mobile-menu');
        const mobileMenuLinks = wrapper.querySelectorAll('.mobile-menu a');
        const desktopViewport = window.matchMedia('(min-width: 960px)');

        const setMenuState = (isOpen) => {
          navbar.classList.toggle('menu-open', isOpen);
          document.body.classList.toggle('nav-locked', isOpen);
          if (menuToggle) menuToggle.setAttribute('aria-expanded', String(isOpen));
          if (mobileMenu) mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        };

        const shouldHideAnnouncement = () => {
          if (announcementTrigger) {
            const triggerTop = announcementTrigger.getBoundingClientRect().top;
            const hideThreshold = window.innerHeight * 0.82;
            return triggerTop <= hideThreshold;
          }

          return window.scrollY > 72;
        };

        const applyScrollState = () => {
          navbar.classList.toggle('is-scrolled', window.scrollY > 20);
          document.body.classList.toggle('announcement-hidden', shouldHideAnnouncement());
        };

        menuToggle?.addEventListener('click', () => setMenuState(true));
        menuClose?.addEventListener('click', () => setMenuState(false));
        mobileMenu?.addEventListener('click', (event) => {
          if (event.target === mobileMenu) setMenuState(false);
        });
        mobileMenuLinks.forEach((link) => link.addEventListener('click', () => setMenuState(false)));
        desktopViewport.addEventListener('change', (event) => {
          if (event.matches) setMenuState(false);
        });

        window.addEventListener('scroll', applyScrollState, { passive: true });
        window.addEventListener('resize', applyScrollState);
        applyScrollState();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initSwimdaysHomeHeader());
    } else {
      initSwimdaysHomeHeader();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initSwimdaysHomeHeader(event.target);
    });
  })();
{% endjavascript %}
