{% liquid
  assign base_url = request.origin | default: shop.url
  assign product_url = base_url | append: product.url
  assign currency_code = cart.currency.iso_code | default: shop.currency
  assign product_description = product.description | strip_html | strip_newlines | strip | default: product.title
  assign primary_image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.images.first
  assign brand_name = product.vendor | default: shop.name
  assign aggregate_availability = 'https://schema.org/OutOfStock'

  if product.available
    assign aggregate_availability = 'https://schema.org/InStock'
  endif
%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProductGroup",
    "@id": {{ product_url | append: '#product-group' | json }},
    "name": {{ product.title | strip | json }},
    "description": {{ product_description | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ brand_name | json }}
    },
    "url": {{ product_url | json }},
    "productGroupID": {{ product.id | json }},
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": {{ currency_code | json }},
      "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
      "price": {{ product.price_min | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size | json }},
      "availability": {{ aggregate_availability | json }},
      "url": {{ product_url | json }}
    }{% if product.type != blank %},
    "category": {{ product.type | json }}{% endif %}{% if primary_image != blank %},
    "image": {{ primary_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %},
    "hasVariant": [
      {% for variant in product.variants %}
        {% liquid
          assign variant_url = base_url | append: variant.url
          assign variant_image = variant.featured_media.preview_image | default: primary_image
          assign variant_availability = 'https://schema.org/OutOfStock'
          assign variant_name = product.title

          if variant.title != blank and variant.title != 'Default Title'
            assign variant_name = product.title | append: ' - ' | append: variant.title
          endif

          if variant.available
            assign variant_availability = 'https://schema.org/InStock'
          endif
        %}
        {
          "@type": "Product",
          "@id": {{ variant_url | append: '#variant' | json }},
          "name": {{ variant_name | json }},
          "url": {{ variant_url | json }}{% if variant.sku != blank %},
          "sku": {{ variant.sku | json }}{% endif %}{% if variant_image != blank %},
          "image": {{ variant_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %},
          "offers": {
            "@type": "Offer",
            "priceCurrency": {{ currency_code | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": {{ variant_availability | json }},
            "url": {{ variant_url | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>
