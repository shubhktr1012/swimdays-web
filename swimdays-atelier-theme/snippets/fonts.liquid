{% # theme-check-disable %}
{%- assign body_font = settings.type_body_font -%}
{%- if body_font != blank and body_font.family != blank and body_font.system? == false -%}
  <link
    rel="preload"
    as="font"
    href="{{ body_font | font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endif -%}
