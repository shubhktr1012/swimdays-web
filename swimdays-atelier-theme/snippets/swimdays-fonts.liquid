{%- comment -%} Swimdays brand fonts (local assets) {%- endcomment -%}

<style>
  @font-face {
    font-family: 'Aboreto';
    src: url('{{ 'Aboreto-Regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('{{ 'Poppins-Regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('{{ 'Poppins-Medium.ttf' | asset_url }}') format('truetype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Public Sans';
    src: url('{{ 'PublicSans-Regular.ttf' | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Katheriny';
    src: url('{{ 'KatherinySignatureFreeReg-j91M0.otf' | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-heading--family: 'Aboreto', serif;
    --font-heading--style: normal;
    --font-heading--weight: 400;

    --font-subheading--family: 'Poppins', sans-serif;
    --font-subheading--style: normal;
    --font-subheading--weight: 500;

    --font-body--family: 'Public Sans', sans-serif;
    --font-body--style: normal;
    --font-body--weight: 400;

    --font-accent--family: 'Katheriny', cursive;
    --font-accent--style: normal;
    --font-accent--weight: 400;
  }
</style>

<link rel="preload" href="{{ 'Aboreto-Regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
<link rel="preload" href="{{ 'PublicSans-Regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
