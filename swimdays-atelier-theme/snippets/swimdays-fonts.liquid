{%- comment -%} Swimdays brand fonts (WOFF2). Also defines Swimdays* aliases so homepage sections need not re-download. {%- endcomment -%}

<style>
  @font-face {
    font-family: 'Aboreto';
    src: url('{{ 'Aboreto-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('{{ 'Poppins-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('{{ 'Poppins-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Public Sans';
    src: url('{{ 'PublicSans-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Katheriny';
    src: url('{{ 'KatherinySignatureFreeReg.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Homepage section aliases — same files, no second download */
  @font-face {
    font-family: 'Swimdays Heading';
    src: url('{{ 'Aboreto-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Swimdays Subhead';
    src: url('{{ 'Poppins-Medium.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Swimdays Body';
    src: url('{{ 'PublicSans-Regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Swimdays Accent';
    src: url('{{ 'KatherinySignatureFreeReg.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-heading--family: 'Aboreto', serif;
    --font-heading--style: normal;
    --font-heading--weight: 400;

    --font-subheading--family: 'Poppins', sans-serif;
    --font-subheading--style: normal;
    --font-subheading--weight: 500;

    --font-body--family: 'Public Sans', sans-serif;
    --font-body--style: normal;
    --font-body--weight: 400;

    --font-accent--family: 'Katheriny', cursive;
    --font-accent--style: normal;
    --font-accent--weight: 400;
  }
</style>

<link rel="preload" href="{{ 'Aboreto-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'PublicSans-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
