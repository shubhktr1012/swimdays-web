<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign raw_page_title = page_title | strip
  assign title_core = raw_page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign raw_description = page_description
  assign curated_description = blank
  assign social_image = page_image
  assign site_social_image_url = request.origin | append: '/cdn/shop/files/mink-mingle-AlEyuIKuSmc-unsplash.jpg?v=1773484685'
  assign social_image_url = blank
  assign social_image_width = blank
  assign social_image_height = blank

  if request.page_type == 'index' or request.page_type == 'page' or request.page_type == 'blog' or request.page_type == 'list-collections'
    assign social_image = blank
  endif

  if raw_description == blank
    if request.page_type == 'product' and product
      case product.handle
        when 'moss-full-sleeves-bodysuit'
          assign curated_description = 'Front-zip Moss full sleeves bodysuit with hand-beaded jellyfish detail, snug stretch fit and layering options for modest swimwear.'
        when 'moss-sleeveless-bodysuit'
          assign curated_description = 'Front-zip Moss sleeveless bodysuit with hand-beaded jellyfish detail, snug stretch fit and easy layering for modest swimwear.'
        when 'moss-halter-swim-dress'
          assign curated_description = 'Moss halter swim dress with a flared silhouette, hand-beaded jellyfish detail and optional shorts for sporty, layered coverage.'
        when 'moss-swim-leggings'
          assign curated_description = 'Mid-waist Moss swim leggings with a broad waistband, ankle-length fit and flexible stretch for swimming, yoga and pilates.'
        when 'moss-wrap-tulip-skirt'
          assign curated_description = 'Moss wrap-tulip skirt with a side bow, adjustable belt and stretch fit for elegant layered coverage over swimwear.'
        when 'moss-swim-shorts'
          assign curated_description = 'Mid-waist Moss swim shorts with a broad waistband and snug stretch fit for smooth coverage under swim dresses or on their own.'
        when 'cove-full-sleeves-bodysuit'
          assign curated_description = 'Front-zip Cove full sleeves bodysuit with hand-beaded starfish detail, snug stretch fit and layering options for modest swimwear.'
        when 'cove-sleeveless-bodysuit'
          assign curated_description = 'Front-zip Cove sleeveless bodysuit with hand-beaded starfish detail, snug stretch fit and easy layering for modest swimwear.'
        when 'cove-halter-swim-dress'
          assign curated_description = 'Cove halter swim dress with a flared silhouette, hand-beaded starfish detail and optional shorts for sporty, layered coverage.'
        when 'cove-swim-leggings'
          assign curated_description = 'Mid-waist Cove swim leggings with a broad waistband, ankle-length fit and flexible stretch for swimming, yoga and pilates.'
        when 'cove-wrap-tulip-skirt'
          assign curated_description = 'Cove wrap-tulip skirt with a side bow, adjustable belt and stretch fit for elegant layered coverage over swimwear.'
        when 'cove-swim-shorts'
          assign curated_description = 'Mid-waist Cove swim shorts with a broad waistband and snug stretch fit for smooth coverage under swim dresses or on their own.'
      endcase
    elsif request.page_type == 'collection' and collection
      case collection.handle
        when 'moss'
          assign curated_description = 'Explore the Moss collection: hand-beaded jellyfish swimwear, leggings, skirts and shorts designed for elegant layered coverage.'
        when 'cove'
          assign curated_description = 'Explore the Cove collection: hand-beaded starfish swimwear, leggings, skirts and shorts designed for elegant layered coverage.'
      endcase
    endif

    if curated_description != blank
      assign raw_description = curated_description
    elsif request.page_type == 'product' and product.description != blank
      assign raw_description = product.description
    elsif request.page_type == 'collection' and collection
      assign raw_description = collection.title | append: ' from ' | append: shop.name | append: '. ' | append: shop.description
    elsif request.page_type == 'article' and article.excerpt_or_content != blank
      assign raw_description = article.excerpt_or_content
    elsif request.page_type == 'blog' and blog
      assign raw_description = blog.title | append: ' from ' | append: shop.name | append: '. ' | append: shop.description
    elsif request.page_type == 'page' and page
      assign raw_description = page.title | append: '. ' | append: shop.description
    endif
  endif

  if request.page_type == 'product' and product
    assign default_product_title = product.title | strip

    if raw_page_title == blank or raw_page_title == default_product_title
      assign title_core = product.title
      assign product_title_suffix = product.type | default: 'Modest Swimwear'

      if request.query_string contains 'variant=' and product.selected_or_first_available_variant.title != 'Default Title'
        assign title_core = title_core | append: ' ' | append: product.selected_or_first_available_variant.title
      endif

      assign title_core = title_core | append: ' | ' | append: product_title_suffix
    else
      assign title_core = raw_page_title
    endif

    if social_image == blank
      assign social_image = product.selected_or_first_available_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.images.first
    endif
  elsif request.page_type == 'collection' and collection
    assign default_collection_title = collection.title | strip

    if raw_page_title == blank or raw_page_title == default_collection_title
      if collection.handle == 'all'
        assign title_core = 'Shop All | Modest Swimwear'
      else
        assign title_core = collection.title | append: ' | Modest Swimwear'
      endif
    else
      assign title_core = raw_page_title
    endif

    if social_image == blank
      assign social_image = collection.image
    endif
    if social_image == blank and collection.products.first
      assign social_image = collection.products.first.featured_media.preview_image
    endif
  elsif request.page_type == 'blog' and blog
    assign title_core = blog.title | append: ' | Swimwear Journal'

    if social_image == blank and blog.articles.first
      assign social_image = blog.articles.first.image
    endif
  elsif request.page_type == 'article' and article
    assign title_core = article.title | strip | truncate: 48, '...'

    if social_image == blank
      assign social_image = article.image
    endif
  elsif request.page_type == 'page' and page
    case page.handle
      when 'contact'
        assign title_core = 'Contact | Support and Enquiries'
      when 'our-story'
        assign title_core = 'Our Story | About the Brand'
      when 'partial-payment-policy'
        assign title_core = 'Partial Payment Policy'
      else
        assign title_core = page.title | append: ' | Official Site'
    endcase
  elsif request.page_type == 'list-collections'
    assign title_core = 'Collections | Modest Swimwear'
  endif

  capture seo_title
    echo title_core
    if current_tags
      echo ' - tagged "'
      echo current_tags | join: ', '
      echo '"'
    endif
    if current_page != 1
      echo ' - Page '
      echo current_page
    endif
    unless title_core contains shop.name
      echo ' - '
      echo shop.name
    endunless
  endcapture

  assign og_title = seo_title | strip
  assign seo_description = raw_description | default: shop.description | default: shop.name | strip_html | strip_newlines | strip | truncate: 155
  assign og_description = seo_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if social_image != blank
    assign social_image_url = social_image | image_url: width: 1600 | prepend: 'https:'
    assign social_image_width = social_image.width
    assign social_image_height = social_image.height
  else
    assign social_image_url = site_social_image_url
    assign social_image_width = 2400
    assign social_image_height = 1600
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if social_image_url != blank -%}
  <meta
    property="og:image"
    content="{{ social_image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ social_image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ social_image_width }}"
  >
  <meta
    property="og:image:height"
    content="{{ social_image_height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if social_image_url != blank -%}
  <meta
    name="twitter:image"
    content="{{ social_image_url }}"
  >
{%- endif -%}

<title>
  {{ seo_title | strip }}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% else %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
