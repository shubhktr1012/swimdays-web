{% style %}
  @font-face {
    font-family: "Swimdays Heading";
    src: url("{{ 'Aboreto-Regular.ttf' | asset_url }}") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Swimdays Subhead";
    src: url("{{ 'Poppins-Medium.ttf' | asset_url }}") format("truetype");
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }

  @font-face {
    font-family: "Swimdays Body";
    src: url("{{ 'PublicSans-Regular.ttf' | asset_url }}") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Swimdays Accent";
    src: url("{{ 'KatherinySignatureFreeReg-j91M0.otf' | asset_url }}") format("opentype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
{% endstyle %}
