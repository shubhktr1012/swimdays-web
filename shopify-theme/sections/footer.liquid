<footer class="site-footer" role="contentinfo">
  <div class="page-width site-footer__grid">
    <div>
      <h2>{{ shop.name }}</h2>
      <p>{{ section.settings.brand_copy }}</p>
    </div>

    <div>
      <h3>Menu</h3>
      <ul>
        {% for link in section.settings.footer_menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h3>Policies</h3>
      <ul>
        {% if shop.privacy_policy.url %}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{% endif %}
        {% if shop.refund_policy.url %}<li><a href="{{ shop.refund_policy.url }}">Return policy</a></li>{% endif %}
        {% if shop.terms_of_service.url %}<li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>{% endif %}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_copy",
      "label": "Brand copy",
      "default": "Modest luxury swimwear with handcrafted finishes, designed for confidence and comfort."
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
