<section class="section" id="featured-collection">
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.copy }}</p>
    </div>

    {%- assign collection = section.settings.collection -%}
    <div class="product-grid">
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a class="product-card__media" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
            <div class="product-card__meta">
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p>{{ product.price | money }}</p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__meta">
              <h3>Featured product {{ i }}</h3>
              <p>{{ 8900 | money }}</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "A focused drop designed for beach days, resort nights, and confident coverage."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
