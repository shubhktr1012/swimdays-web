<section class="hero" id="hero">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '768, 1024, 1400, 1800, 2200' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="hero__content page-width">
    <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__subtitle">{{ section.settings.subheading }}</p>

    <div class="hero__actions">
      <a class="btn btn--solid" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      <a class="btn btn--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    </div>

    <a class="hero__scroll" href="#" data-scroll-target="#featured-collection">Scroll to explore</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Swimdays"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modest swimwear, crafted with intention"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Editorial silhouettes in premium fabrics with hand-finished embroidery details."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary label",
      "default": "View the lookbook"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
