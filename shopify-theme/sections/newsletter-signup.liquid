<section class="section">
  <div class="page-width">
    <div class="newsletter">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>

      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email</label>
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required placeholder="you@example.com" autocorrect="off" autocapitalize="off">
        <button class="btn btn--solid" type="submit">{{ section.settings.button_text }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the current"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Be first to see new drops, lookbooks, and limited edits."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
