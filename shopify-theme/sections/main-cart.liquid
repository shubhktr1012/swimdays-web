<section class="section">
  <div class="page-width">
    <h1>{{ 'cart.title' | t }}</h1>

    {% if cart.item_count == 0 %}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Qty</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                </td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <p><strong>Subtotal:</strong> {{ cart.total_price | money }}</p>

        <div style="display:flex; gap: 0.75rem; flex-wrap:wrap;">
          <button class="btn btn--outline" type="submit">Update cart</button>
          <button class="btn btn--solid" name="checkout" type="submit">Checkout</button>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
