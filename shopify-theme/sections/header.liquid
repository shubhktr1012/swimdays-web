<header class="site-header" role="banner">
  <div class="page-width site-header__row">
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <nav aria-label="Main navigation">
      <ul class="site-header__menu">
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <a href="{{ routes.cart_url }}" aria-label="Cart">Cart ({{ cart.item_count }})</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
